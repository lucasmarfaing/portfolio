---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import Hero from '@/sections/Hero.astro';
import Crew from '@/sections/Crew.astro';
import Trajectory from '@/sections/Trajectory.astro';
import Inventory from '@/sections/Inventory.astro';
import Missions from '@/sections/Missions.astro';
import { getContent, type Locale } from '@/lib/content';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const { site, hero, crew, trajectory, inventory, sky, missions } = getContent(lang);
---

<BaseLayout lang={lang} title={site.meta.title} description={site.meta.description}>
  <SiteHeader site={site} />
  <main>
    <Hero content={hero} />
    <Crew content={crew} callsign={site.callsign} />
    <Trajectory content={trajectory} />
    <Inventory content={inventory} sky={sky} callsign={site.callsign} />
    <Missions content={missions} technos={sky.stars.length} />
  </main>
</BaseLayout>

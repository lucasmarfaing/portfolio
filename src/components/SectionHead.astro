---
interface Props {
  index: string;
  label: string;
  title: string;
  titleMuted?: string;
  id?: string;
}

const { index, label, title, titleMuted, id } = Astro.props;
---

<div class="section-head">
  <p class="mono-label"><span class="section-head__index">{index}</span> — {label}</p>
  <h2 class="section-head__title" id={id}>
    {title}
    {titleMuted && (<><br /><span class="section-head__muted">{titleMuted}</span></>)}
  </h2>
</div>

<style>
  .section-head {
    display: flex;
    flex-direction: column;
    gap: clamp(14px, 2.4vh, 28px);
  }

  .section-head__index {
    color: var(--accent);
  }

  .section-head__title {
    margin: 0;
    font-size: clamp(36px, min(4.2vw, 6vh), 60px);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: -0.045em;
  }

  .section-head__muted {
    color: var(--text-muted);
  }

  @media (max-width: 1099px) {
    .section-head {
      gap: 24px;
    }

    .section-head .mono-label {
      font-size: 11px;
    }
  }
</style>

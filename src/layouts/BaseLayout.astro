---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '@/styles/global.css';
import { theme, themeCss } from '@/lib/theme';
import type { Locale } from '@/lib/content';

interface Props {
  lang: Locale;
  title: string;
  description: string;
  /** Pages that must not appear in search results (404) */
  noindex?: boolean;
}

const { lang, title, description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const alternates = [
  { lang: 'fr', href: new URL('/', Astro.site) },
  { lang: 'en', href: new URL('/en/', Astro.site) },
];
---

<!doctype html>
<html lang={lang} data-theme={theme.default}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    {!noindex && alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
    {!noindex && <link rel="alternate" hreflang="x-default" href={alternates[0]!.href} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'fr' ? 'fr_FR' : 'en_US'} />
    <meta name="theme-color" content={theme[theme.default].bg} />
    <style is:inline set:html={themeCss}></style>
    <script is:inline>
      try {
        var saved = localStorage.getItem('theme');
        if (saved === 'dark' || saved === 'light') document.documentElement.dataset.theme = saved;
      } catch (e) {}
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>

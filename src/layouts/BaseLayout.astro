---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '@/styles/global.css';
import { theme, themeCss } from '@/lib/theme';
import { domains } from '@/lib/domains';
import { getContent, type Locale } from '@/lib/content';
import { getImage } from 'astro:assets';
import portrait from '@/assets/images/portrait.png';

interface Props {
  lang: Locale;
  title: string;
  description: string;
  /** Pages that must not appear in search results (404) */
  noindex?: boolean;
}

const { lang, title, description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const alternates = [
  { lang: 'fr', href: new URL('/', Astro.site) },
  { lang: 'en', href: new URL('/en/', Astro.site) },
];

// Structured data so Google knows who the site is about (name, job, profiles)
const content = getContent(lang);
const home = alternates[0]!.href.href;
const photo = await getImage({ src: portrait, width: 600, format: 'jpg' });
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${home}#person`,
      name: `${content.hero.firstName} ${content.hero.lastName}`,
      jobTitle: content.crew.badge.job.split('·')[0]!.trim(),
      worksFor: content.crew.badge.job.includes('·')
        ? { '@type': 'Organization', name: content.crew.badge.job.split('·').at(-1)!.trim() }
        : undefined,
      description: content.site.meta.description,
      url: home,
      image: new URL(photo.src, Astro.site).href,
      email: `mailto:${content.contact.form.mailTo}`,
      address: { '@type': 'PostalAddress', addressLocality: content.trajectory.origin.city, addressCountry: 'FR' },
      sameAs: content.contact.channels.map((c) => c.url).filter((u): u is string => !!u && /^https:/.test(u)),
    },
    {
      '@type': 'WebSite',
      '@id': `${home}#website`,
      name: `${content.hero.firstName} ${content.hero.lastName}`,
      url: home,
      inLanguage: ['fr', 'en'],
      publisher: { '@id': `${home}#person` },
    },
  ],
};
---

<!doctype html>
<html lang={lang} data-theme={theme.default}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    {!noindex && alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
    {!noindex && <link rel="alternate" hreflang="x-default" href={alternates[0]!.href} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'fr' ? 'fr_FR' : 'en_US'} />
    <meta property="og:image" content={new URL('/og.png', Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${content.hero.firstName} ${content.hero.lastName} — ${content.hero.tagline}`} />
    <meta property="og:site_name" content={`${content.hero.firstName} ${content.hero.lastName}`} />
    <meta name="twitter:card" content="summary_large_image" />
    {!noindex && <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
    <meta name="theme-color" content={theme[theme.default].bg} />
    <style is:inline set:html={themeCss}></style>
    <script is:inline>
      try {
        var saved = localStorage.getItem('theme');
        if (saved === 'dark' || saved === 'light') document.documentElement.dataset.theme = saved;
      } catch (e) {}
    </script>
  </head>
  <body>
    <slot />
    <!--
      The same site is served on several domains (src/content/domains.json). The HTML is built with the
      main one; elements marked data-email-domain get the domain the visitor actually used
      (ask@lucasmarfaing.dev on lucasmarfaing.dev, and so on).
    -->
    <script is:inline define:vars={{ domains }}>
      (function () {
        var main = domains[0];
        var host = location.hostname.replace(/^www\./, '');
        if (host === main || domains.indexOf(host) < 0) return;
        document.querySelectorAll('[data-email-domain]').forEach(function (el) {
          ['href', 'data-mailto'].forEach(function (attr) {
            var value = el.getAttribute(attr);
            if (value) el.setAttribute(attr, value.split('@' + main).join('@' + host));
          });
          var walker = document.createTreeWalker(el, NodeFilter.SHOW_TEXT);
          var node;
          while ((node = walker.nextNode())) {
            if (node.nodeValue.indexOf('@' + main) >= 0) node.nodeValue = node.nodeValue.split('@' + main).join('@' + host);
          }
        });
      })();
    </script>
  </body>
</html>

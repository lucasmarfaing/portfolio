---
import Icon from '@/components/Icon.astro';
import { fill, type ContactContent } from '@/lib/content';

interface Props {
  content: ContactContent;
  callsign: string;
}

const { content, callsign } = Astro.props;
const { form, footer } = content;
const year = new Date().getFullYear();
const isPlaceholder = (text: string) => text.trim().startsWith('[');
---

<section id="contact" class="contact" aria-labelledby="contact-title">
  <div class="contact__horizon" aria-hidden="true"></div>

  <div class="container contact__inner">
    <div class="contact__main">
      <div class="contact__intro">
        <p class="mono-label"><span class="contact__index">{content.index}</span> — {content.label}</p>
        <h2 class="contact__title" id="contact-title">
          {content.title}
          <br />
          <span class="contact__accent">{content.titleAccent}</span>
        </h2>
        <p class="contact__text">{content.intro}</p>
        <span class="contact__badge">
          <span class="contact__badge-dot blink" aria-hidden="true"></span>
          <span class="contact__badge-long">{content.availability}</span>
          <span class="contact__badge-short">{content.availabilityShort}</span>
        </span>
        <ul class="channels">
          {
            content.channels.map((c) => {
              const Tag = c.url ? 'a' : 'div';
              return (
                <li>
                  <Tag
                    class:list={['channel', { 'is-static': !c.url }]}
                    href={c.url}
                    data-email-domain
                    {...(c.url && /^https?:|\.pdf$/.test(c.url) ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
                    <span class="channel__main">
                      <Icon name={c.icon} size={20} class="channel__icon" />
                      <span class="channel__text">
                        <span class="channel__label">{c.label}</span>
                        <span class:list={['channel__value', { 'is-placeholder': isPlaceholder(c.value) }]}>{c.value}</span>
                      </span>
                    </span>
                    <span class="channel__signal" aria-hidden="true">
                      <span />
                      <span />
                      <span />
                      <span />
                    </span>
                  </Tag>
                </li>
              );
            })
          }
        </ul>
      </div>

      <div class="console" data-console data-email-domain data-endpoint={form.endpoint} data-mailto={form.mailTo} data-subject={form.mailSubject}>
        <div class="console__bar">
          <span class="console__title-long">{form.console}</span>
          <span class="console__title-short">{form.consoleShort}</span>
          <span class="console__status" data-status data-open={form.statusOpen} data-sending={form.statusSending} data-sent={form.statusSent}>
            <span class="console__status-dot" aria-hidden="true"></span>
            <span data-status-label>{form.statusOpen}</span>
          </span>
        </div>

        <form class="console__form" data-form novalidate>
          <fieldset class="types">
            <legend class="field__label">{form.typeLabel}</legend>
            <div class="types__list">
              {
                form.types.map((t, i) => (
                  <button type="button" class="type-chip" aria-pressed={i === 0 ? 'true' : 'false'} data-type={t}>
                    {t}
                  </button>
                ))
              }
            </div>
            <input type="hidden" name="type" value={form.types[0]} data-type-input />
          </fieldset>
          <div class="fields-row">
            <label class="field">
              <span class="field__label">{form.nameLabel}</span>
              <input class="field__input" type="text" name="name" placeholder={form.namePlaceholder} autocomplete="name" required />
            </label>
            <label class="field">
              <span class="field__label">{form.emailLabel}</span>
              <input class="field__input" type="email" name="email" placeholder={form.emailPlaceholder} autocomplete="email" required />
            </label>
          </div>
          <label class="field">
            <span class="field__label">{form.messageLabel}</span>
            <textarea class="field__input" name="message" rows="5" placeholder={form.messagePlaceholder} required></textarea>
          </label>
          <!-- Spam trap: real visitors never fill this hidden field -->
          <input class="trap" type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <p class="console__error" data-error hidden>
            {form.errorText} <a href={`mailto:${form.mailTo}`} data-email-domain>{form.mailTo}</a>
          </p>
          <button type="submit" class="console__submit">
            {form.submit}
            <Icon name="send" size={18} strokeWidth={2} />
          </button>
        </form>

        <div class="console__done" data-done hidden>
          <span class="console__check"><Icon name="check" size={30} strokeWidth={2.2} /></span>
          <p class="console__done-title">{form.sentTitle}</p>
          <p class="console__done-text" data-done-text data-api={form.sentText} data-mail={form.sentTextMail}>{form.sentText}</p>
          <button type="button" class="console__reset" data-reset>{form.reset}</button>
        </div>
      </div>
    </div>

    <footer class="site-footer">
      <div class="site-footer__top">
        <span class="site-footer__signoff"><span class="site-footer__mark" aria-hidden="true"></span>{callsign} · {footer.signoff}</span>
        <a class="site-footer__up" href="#top">
          {footer.backToTop}
          <Icon name="arrowUp" size={16} strokeWidth={2} />
        </a>
      </div>
      <div class="site-footer__bottom">
        <span>{fill(footer.copyright, { year })}</span>
        <span class="site-footer__coords">{footer.coords}</span>
      </div>
    </footer>
  </div>
</section>

<script>
  for (const consoleEl of document.querySelectorAll<HTMLElement>('[data-console]')) {
    const form = consoleEl.querySelector<HTMLFormElement>('[data-form]')!;
    const done = consoleEl.querySelector<HTMLElement>('[data-done]')!;
    const doneText = consoleEl.querySelector<HTMLElement>('[data-done-text]')!;
    const error = consoleEl.querySelector<HTMLElement>('[data-error]')!;
    const status = consoleEl.querySelector<HTMLElement>('[data-status]')!;
    const statusLabel = consoleEl.querySelector<HTMLElement>('[data-status-label]')!;
    const typeInput = consoleEl.querySelector<HTMLInputElement>('[data-type-input]')!;
    const chips = [...consoleEl.querySelectorAll<HTMLButtonElement>('[data-type]')];
    const submit = form.querySelector<HTMLButtonElement>('[type="submit"]')!;

    const setStatus = (state: 'open' | 'sending' | 'sent') => {
      status.dataset.state = state;
      statusLabel.textContent = status.dataset[state] ?? '';
    };

    chips.forEach((chip) =>
      chip.addEventListener('click', () => {
        chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
        typeInput.value = chip.dataset.type ?? '';
      }),
    );

    const showDone = (text: string) => {
      doneText.textContent = text;
      form.hidden = true;
      done.hidden = false;
      setStatus('sent');
      done.querySelector<HTMLButtonElement>('[data-reset]')?.focus();
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      error.hidden = true;
      if (!form.reportValidity()) return;
      const data = new FormData(form);
      if (data.get('_gotcha')) return;
      const endpoint = consoleEl.dataset.endpoint ?? '';

      // No form service configured: open the visitor's mail app with the message ready
      if (!endpoint) {
        const subject = (consoleEl.dataset.subject ?? '')
          .replace('{type}', String(data.get('type') ?? ''))
          .replace('{name}', String(data.get('name') ?? ''));
        const body = `${data.get('message')}\n\n— ${data.get('name')} <${data.get('email')}>`;
        window.location.href = `mailto:${consoleEl.dataset.mailto}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
        showDone(doneText.dataset.mail ?? '');
        return;
      }

      setStatus('sending');
      submit.disabled = true;
      try {
        const response = await fetch(endpoint, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
        if (!response.ok) throw new Error(String(response.status));
        showDone(doneText.dataset.api ?? '');
      } catch {
        setStatus('open');
        error.hidden = false;
      } finally {
        submit.disabled = false;
      }
    });

    done.querySelector('[data-reset]')?.addEventListener('click', () => {
      form.reset();
      chips.forEach((c, i) => c.setAttribute('aria-pressed', String(i === 0)));
      typeInput.value = chips[0]?.dataset.type ?? '';
      done.hidden = true;
      form.hidden = false;
      setStatus('open');
      form.querySelector<HTMLInputElement>('input[name="name"]')?.focus();
    });
  }
</script>

<style>
  .contact {
    position: relative;
    overflow: hidden;
    padding-top: var(--section-pad-top);
    background: var(--bg);
  }

  /* The planet's horizon rising at the bottom of the page */
  .contact__horizon {
    position: absolute;
    left: 50%;
    bottom: -1650px;
    width: 2400px;
    height: 2000px;
    border-radius: 50%;
    transform: translateX(-50%);
    background: radial-gradient(circle at 50% 0%, var(--horizon-core) 0%, var(--horizon-mid) 40%, var(--bg) 70%);
    box-shadow:
      0 -2px 0 color-mix(in srgb, var(--accent) 55%, transparent),
      0 -30px 120px -20px color-mix(in srgb, var(--accent) 35%, transparent),
      0 -80px 200px -40px color-mix(in srgb, var(--star-blue) 25%, transparent);
    pointer-events: none;
  }

  .contact__inner {
    position: relative;
    display: flex;
    flex-direction: column;
  }

  .contact__main {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 580px);
    gap: 80px;
  }

  .contact__intro {
    display: flex;
    flex-direction: column;
    gap: clamp(20px, 3.2vh, 32px);
  }

  .contact__index {
    color: var(--accent);
  }

  .contact__title {
    margin: 0;
    font-size: clamp(44px, min(5.3vw, 8vh), 76px);
    font-weight: 600;
    line-height: 0.98;
    letter-spacing: -0.05em;
  }

  .contact__accent {
    color: var(--accent);
  }

  .contact__text {
    margin: 0;
    max-width: 520px;
    font-size: 19px;
    line-height: 1.6;
    color: var(--text-soft);
  }

  .contact__badge {
    display: inline-flex;
    align-self: flex-start;
    align-items: center;
    gap: 10px;
    padding: 9px 16px;
    border: 1px solid color-mix(in srgb, var(--warning) 35%, transparent);
    border-radius: 999px;
    background: color-mix(in srgb, var(--warning) 6%, transparent);
    color: var(--warning);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .contact__badge-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--warning);
  }

  .contact__badge-short {
    display: none;
  }

  /* ---------- Channels ---------- */

  .channels {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    margin: 8px 0 0;
    padding: 0;
    list-style: none;
  }

  .channel {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    min-height: 56px;
    padding: 16px 18px;
    border: 1px solid color-mix(in srgb, var(--text) 9%, transparent);
    border-radius: 12px;
    color: var(--text-soft);
    text-decoration: none;
    transition: background-color 0.2s, border-color 0.2s;
  }

  a.channel:hover {
    border-color: color-mix(in srgb, var(--accent) 45%, transparent);
    background: color-mix(in srgb, var(--text) 3%, transparent);
  }

  .channel__main {
    display: flex;
    align-items: center;
    gap: 14px;
    min-width: 0;
  }

  .channel :global(.channel__icon) {
    flex: none;
    color: var(--accent);
  }

  .channel__text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .channel__label {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .channel__value {
    overflow: hidden;
    font-size: 15px;
    white-space: nowrap;
    text-overflow: ellipsis;
    color: var(--text);
  }

  .channel__value.is-placeholder {
    color: var(--text-faint);
  }

  .channel__signal {
    display: flex;
    align-items: flex-end;
    gap: 2px;
    height: 14px;
  }

  .channel__signal span {
    width: 3px;
    background: var(--success);
    animation: signal 1.6s ease-in-out infinite;
  }

  .channel__signal span:nth-child(1) {
    height: 5px;
  }

  .channel__signal span:nth-child(2) {
    height: 8px;
    animation-delay: 0.15s;
  }

  .channel__signal span:nth-child(3) {
    height: 11px;
    animation-delay: 0.3s;
  }

  .channel__signal span:nth-child(4) {
    height: 14px;
    animation-delay: 0.45s;
  }

  .is-static .channel__signal span {
    background: color-mix(in srgb, var(--text) 18%, transparent);
    animation: none;
  }

  @keyframes signal {
    50% {
      opacity: 0.35;
    }
  }

  /* ---------- Console (form) ---------- */

  .console {
    position: relative;
    align-self: start;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--text) 10%, transparent);
    border-radius: 18px;
    background: color-mix(in srgb, var(--surface) 85%, transparent);
  }

  .console__bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 14px 22px;
    border-bottom: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .console__title-short {
    display: none;
  }

  .console__status {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--warning);
  }

  .console__status[data-state='sent'] {
    color: var(--success);
  }

  .console__status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: currentColor;
  }

  .console__status[data-state='sending'] .console__status-dot {
    animation: blink 0.8s ease-in-out infinite;
  }

  .console__form {
    display: flex;
    flex-direction: column;
    gap: clamp(12px, 2vh, 18px);
    padding: 24px 22px 22px;
  }

  .console__form[hidden],
  .console__done[hidden] {
    display: none;
  }

  .types {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .types__list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .type-chip {
    min-height: 40px;
    padding: 9px 16px;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: transparent;
    color: var(--text-soft);
    font-size: 14px;
    cursor: pointer;
    transition: background-color 0.2s, border-color 0.2s, color 0.2s;
  }

  .type-chip:hover {
    border-color: color-mix(in srgb, var(--accent) 60%, transparent);
  }

  .type-chip[aria-pressed='true'] {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--on-accent);
    font-weight: 600;
  }

  .fields-row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .field__label {
    padding: 0;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .types .field__label {
    margin-bottom: 0;
  }

  .field__input {
    width: 100%;
    min-height: 48px;
    padding: 13px 14px;
    border: 1px solid color-mix(in srgb, var(--text) 10%, transparent);
    border-radius: 10px;
    background: color-mix(in srgb, var(--bg) 60%, var(--surface));
    color: var(--text);
    font: inherit;
    font-size: 15px;
    line-height: 1.5;
    transition: border-color 0.2s;
  }

  textarea.field__input {
    resize: vertical;
  }

  .field__input::placeholder {
    color: var(--text-faint);
  }

  .field__input:focus {
    outline: none;
    border-color: var(--accent);
  }

  .trap {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  .console__error {
    margin: 0;
    font-size: 14px;
    line-height: 1.5;
    color: var(--accent-alt);
  }

  .console__error a {
    color: var(--text);
  }

  .console__submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    min-height: 54px;
    padding: 16px 22px;
    border: 0;
    border-radius: 12px;
    background: var(--accent);
    color: var(--on-accent);
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.2s, gap 0.2s;
  }

  .console__submit:hover {
    background: var(--accent-alt);
    gap: 16px;
  }

  .console__submit:disabled {
    opacity: 0.6;
    cursor: progress;
  }

  .console__done {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
    padding: 60px 32px;
    text-align: center;
  }

  .console__check {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 72px;
    height: 72px;
    border: 2px solid var(--success);
    border-radius: 50%;
    color: var(--success);
    box-shadow: 0 0 40px -6px color-mix(in srgb, var(--success) 60%, transparent);
  }

  .console__done-title {
    margin: 0;
    font-size: 26px;
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  .console__done-text {
    max-width: 380px;
    margin: 0;
    font-size: 15px;
    line-height: 1.6;
    color: var(--text-soft);
  }

  .console__reset {
    min-height: 44px;
    margin-top: 10px;
    padding: 12px 18px;
    border: 1px solid var(--line-strong);
    border-radius: 10px;
    background: transparent;
    color: var(--text);
    font-size: 14px;
    cursor: pointer;
  }

  /* ---------- Footer ---------- */

  .site-footer {
    display: flex;
    flex-direction: column;
    gap: 28px;
    margin-top: clamp(140px, 24vh, 240px);
    padding-bottom: 40px;
  }

  .site-footer__top {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
  }

  .site-footer__signoff {
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .site-footer__mark {
    width: 10px;
    height: 10px;
    border-radius: 2px;
    background: var(--accent);
  }

  .site-footer__up {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    font-size: 14px;
    color: var(--text-soft);
    text-decoration: none;
    transition: color 0.2s;
  }

  .site-footer__up:hover {
    color: var(--accent);
  }

  .site-footer__bottom {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding-top: 20px;
    border-top: 1px solid color-mix(in srgb, var(--text) 8%, transparent);
    font-size: 13px;
    color: var(--text-muted);
  }

  .site-footer__coords {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  /* ---------- Tablet & mobile ---------- */

  @media (max-width: 1099px) {
    .contact {
      border-top: 1px solid var(--line);
    }

    /* Smaller horizon, rising just above the footer */
    .contact__horizon {
      bottom: -660px;
      width: 900px;
      height: 900px;
    }

    .contact__main {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
    }

    /* Mobile order: heading, badge, form, then the channels */
    .contact__intro {
      display: contents;
    }

    .contact__intro > .mono-label {
      order: 1;
      font-size: 11px;
    }

    .contact__title {
      order: 2;
      font-size: 44px;
    }

    .contact__text {
      display: none;
    }

    .contact__badge {
      order: 3;
      gap: 8px;
      padding: 8px 14px;
      font-size: 10px;
      letter-spacing: 0.12em;
    }

    .contact__badge-long {
      display: none;
    }

    .contact__badge-short {
      display: inline;
    }

    .console {
      order: 4;
      border-radius: 16px;
    }

    .channels {
      order: 5;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 8px;
      margin: 0;
    }

    .channels li:first-child {
      grid-column: 1 / -1;
    }

    .channel {
      padding: 14px 16px;
    }

    .console__bar {
      padding: 12px 16px;
    }

    .console__title-long {
      display: none;
    }

    .console__title-short {
      display: inline;
    }

    .console__form {
      gap: 14px;
      padding: 18px 16px;
    }

    .fields-row {
      grid-template-columns: minmax(0, 1fr);
      gap: 14px;
    }

    .field__input {
      font-size: 16px;
    }

    .type-chip {
      padding: 8px 14px;
      font-size: 14px;
    }

    .console__done {
      padding: 40px 20px;
    }

    .site-footer {
      gap: 10px;
      margin-top: 140px;
      padding-bottom: 32px;
    }

    .site-footer__top {
      flex-direction: column-reverse;
      align-items: flex-start;
      gap: 10px;
    }

    .site-footer__bottom {
      flex-direction: column;
      gap: 10px;
      font-size: 12px;
    }

    .site-footer__coords {
      font-size: 10px;
    }
  }

  @media (max-width: 480px) {
    .channels {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

---
import { starField } from '@/assets/star-field';
import SectionHead from '@/components/SectionHead.astro';
import { labelBarcode } from '@/lib/barcode';
import { fill, type InventoryContent, type SkyContent } from '@/lib/content';

interface Props {
  content: InventoryContent;
  sky: SkyContent;
  callsign: string;
}

const { content, sky, callsign } = Astro.props;

const SIZE = 620; // map coordinate system
const pct = (v: number) => `${(v / SIZE) * 100}%`;
const colorVar = {
  red: 'var(--accent)',
  blue: 'var(--star-blue)',
  amber: 'var(--warning)',
  purple: 'var(--star-purple)',
  grey: 'var(--star-off)',
} as const;
const groupById = new Map(sky.groups.map((g) => [g.id, g]));
const groupColor = (id: string) => colorVar[groupById.get(id)!.color];
const buildYear = new Date().getFullYear();
const LEVELS = [3, 2, 1] as const;

// Stars, numbered in file order (R-01, R-02…)
const stars = sky.stars.map((s, i) => {
  const group = groupById.get(s.group)!;
  const text = content.groups[s.group]!;
  const years = s.since === undefined ? undefined : buildYear - s.since;
  return {
    ...s,
    index: i,
    color: groupColor(s.group),
    rated: group.rated && !group.extinct,
    extinct: group.extinct,
    num: `R-${String(i + 1).padStart(2, '0')}`,
    serial: `${callsign.replace(/-/g, '')}-${group.code}-${String(i + 1).padStart(2, '0')}`,
    // The card opens on the side with the most room
    side: s.x <= 330 ? 'right' : 'left',
    card: {
      name: s.name,
      symbol: s.symbol,
      starLine: `★ ${s.star} · ${text.name}`,
      description: content.descriptions[s.name]!,
      since: s.since === undefined ? '' : fill(content.card.since, { year: s.since }),
      years:
        years === undefined || years < 1 ? '' : `· ${years} ${years > 1 ? content.card.years.many : content.card.years.one}`,
      lastUsed: s.lastUsed === undefined ? '' : s.lastUsed === 'current' ? content.card.current : String(s.lastUsed),
      current: s.lastUsed === 'current',
      // Tools have no level; extinct technologies are shown as such
      state: group.extinct ? content.extinctState : group.rated ? content.brightness[s.level] : '',
      sector: text.sector,
      missions: s.missions.map((m) => content.missionNames[m] ?? m),
      url: s.url,
      urlLabel: s.url.replace(/^https?:\/\//, '').replace(/\/$/, ''),
      num: `R-${String(i + 1).padStart(2, '0')}`,
      serial: `${callsign.replace(/-/g, '')}-${group.code}-${String(i + 1).padStart(2, '0')}`,
      // Real Code 128 barcode: label n° i + 1 of the series (the crew pass is n° 00)
      barcode: labelBarcode(callsign, i + 1),
      group: s.group,
      color: groupColor(s.group),
      side: s.x <= 330 ? 'right' : 'left',
      x: s.x,
      y: s.y,
    },
  };
});
const byName = new Map(stars.map((s) => [s.name, s]));

const links = sky.links.map(([a, b]) => {
  const from = byName.get(a)!;
  const to = byName.get(b)!;
  return { x1: from.x, y1: from.y, x2: to.x, y2: to.y, color: from.color, dashed: from.extinct };
});

const bbox = (members: { x: number; y: number }[]) => {
  const xs = members.map((m) => m.x);
  const ys = members.map((m) => m.y);
  return { x0: Math.min(...xs), x1: Math.max(...xs), y0: Math.min(...ys), y1: Math.max(...ys) };
};

const groups = sky.groups.map((g, order) => {
  const members = stars.filter((s) => s.group === g.id);
  const b = bbox(members);
  // A soft glow behind the constellation, around its stars
  const w = Math.max(b.x1 - b.x0 + 100, 260);
  const h = Math.max(b.y1 - b.y0 + 90, 150);
  const cx = (b.x0 + b.x1) / 2;
  const cy = (b.y0 + b.y1) / 2;
  // Small drawing of the constellation in the list header (64×40)
  const scale = Math.min(54 / Math.max(b.x1 - b.x0, 1), 30 / Math.max(b.y1 - b.y0, 1));
  const ox = 32 - ((b.x1 - b.x0) * scale) / 2;
  const oy = 20 - ((b.y1 - b.y0) * scale) / 2;
  const mini = (x: number, y: number) => [+(ox + (x - b.x0) * scale).toFixed(1), +(oy + (y - b.y0) * scale).toFixed(1)] as const;
  const names = new Set(members.map((m) => m.name));
  const items = [...members].sort((p, q) => q.level - p.level);
  return {
    ...g,
    order,
    color: groupColor(g.id),
    text: content.groups[g.id]!,
    items,
    rows: Math.ceil(items.length / 2),
    count: String(members.length).padStart(2, '0'),
    glow: { left: pct(cx - w / 2), top: pct(cy - h / 2), width: pct(w), height: pct(h) },
    mini: {
      dots: members.map((m) => {
        const [x, y] = mini(m.x, m.y);
        return { x, y, r: { 3: 1.9, 2: 1.4, 1: 1.1 }[m.level] };
      }),
      lines: sky.links
        .filter(([a, c]) => names.has(a) && names.has(c))
        .map(([a, c]) => {
          const p = byName.get(a)!;
          const q = byName.get(c)!;
          const [x1, y1] = mini(p.x, p.y);
          const [x2, y2] = mini(q.x, q.y);
          return { x1, y1, x2, y2 };
        }),
    },
  };
});
const sides = { left: groups.filter((g) => g.side === 'left'), right: groups.filter((g) => g.side === 'right') };

const approaching = sky.approaching.map((a) => ({
  ...a,
  side: a.x <= 330 ? 'right' : 'left',
  text: content.approaching.status[a.status],
  note: content.approaching.notes[a.name] ?? '',
}));

// Planisphere graduations
const C = SIZE / 2;
const polar = (r: number, deg: number) => [C + r * Math.cos((deg * Math.PI) / 180), C + r * Math.sin((deg * Math.PI) / 180)] as const;
const radials = Array.from({ length: 12 }, (_, k) => polar(300, k * 30));
const ticks = Array.from({ length: 72 }, (_, k) => {
  const deg = k * 5;
  const [x1, y1] = polar(300, deg);
  const [x2, y2] = polar(deg % 30 === 0 ? 284 : 292, deg);
  return { x1, y1, x2, y2 };
});

const STAR_PATH = 'M12 0 C12.8 8 16 11.2 24 12 C16 12.8 12.8 16 12 24 C11.2 16 8 12.8 0 12 C8 11.2 11.2 8 12 0Z';
const titleMuted = fill(content.titleMuted, { stars: stars.length, groups: sky.groups.length });
---

<section id="inventaire" class="inv" aria-labelledby="inv-title" data-inv>
  <div class="container inv__inner">
    <div class="inv__head">
      <SectionHead id="inv-title" index={content.index} label={content.label} title={content.title} titleMuted={titleMuted} />
      <div class="inv__aside">
        <p class="inv__intro">
          <span class="inv__intro-hover">{content.intro}</span>
          <span class="inv__intro-touch">{content.introTouch}</span>
        </p>
        <ul class="legend">
          {
            LEVELS.map((lvl) => (
              <li>
                <span class="rate rate--legend" aria-hidden="true">
                  {[1, 2, 3].map((k) => <span class:list={{ 'is-on': k <= lvl }} />)}
                </span>
                {content.levels[lvl]}
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="inv__body">
      {
        (['left', 'right'] as const).map((side) => (
          <div class:list={['inv__col', `inv__col--${side}`]}>
            {sides[side].map((g) => (
              <div class:list={['group', { 'is-extinct': g.extinct }]} style={`--c: ${g.color}; order: ${g.order}`} data-group={g.id}>
                <div class="group__head">
                  <h3 class="group__title">
                    <span class="group__label">{g.text.label}</span>
                    <span class="group__name">{g.text.name}</span>
                  </h3>
                  <div class="group__meta">
                    <svg class="group__mini" viewBox="0 0 64 40" aria-hidden="true">
                      {g.mini.lines.map((l) => (
                        <line x1={l.x1} y1={l.y1} x2={l.x2} y2={l.y2} />
                      ))}
                      {g.mini.dots.map((d) => (
                        <circle cx={d.x} cy={d.y} r={d.r} />
                      ))}
                    </svg>
                    <span class="group__count">
                      <span class="group__count-n">{g.count}</span>
                      <span class="group__count-label">{content.starsLabel}</span>
                    </span>
                  </div>
                </div>
                <ul class="group__items" style={`--rows: ${g.rows}`}>
                  {g.items.map((s, k) => (
                    <li class:list={{ 'is-col-top': k % g.rows === 0 }}>
                      <button
                        type="button"
                        class:list={['chip', `lvl-${g.rated && !g.extinct ? s.level : 2}`]}
                        data-star={s.index}
                        aria-pressed="false"
                        aria-controls="inv-card"
                        aria-label={s.rated ? `${s.name} — ${content.brightness[s.level]}` : undefined}>
                        <span class="chip__glyph" aria-hidden="true">
                          <svg viewBox="0 0 24 24">
                            <path d={STAR_PATH} />
                          </svg>
                        </span>
                        <span class="chip__name">{s.name}</span>
                        {s.rated && (
                          <span class="rate" aria-hidden="true">
                            {[1, 2, 3].map((n) => (
                              <span class:list={{ 'is-on': n <= s.level }} />
                            ))}
                          </span>
                        )}
                      </button>
                    </li>
                  ))}
                </ul>
                <div class="group__slot" data-slot={g.id} />
              </div>
            ))}
            {side === 'left' && approaching.length > 0 && (
              <div class="approach" style="order: 99">
                <span class="approach__label">
                  <span class="approach__label-short">{content.approaching.label}</span>
                  <span class="approach__label-long">{content.approaching.labelLong}</span>
                </span>
                <ul class="approach__list">
                  {approaching.map((a) => (
                    <li class:list={['approach__item', `is-${a.status}`]}>
                      <span class="marker" aria-hidden="true">
                        <span class="marker__ping" />
                        <span class="marker__ring" />
                        <span class="marker__dot" />
                      </span>
                      <span class="approach__name">{a.name}</span>
                      <span class="approach__short">{a.text.short}</span>
                      <span class="approach__long">
                        <span class="approach__status">{a.text.long}</span>
                        {a.note && <span class="approach__note">{a.note}</span>}
                      </span>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        ))
      }

      <div class="sky-wrap">
        <div class="sky" data-sky>
          <div class="sky__disc" aria-hidden="true"></div>

          <svg class="sky__field" viewBox="0 0 620 620" aria-hidden="true">
            {starField.map(([x, y, r, o]) => <circle cx={x} cy={y} r={r} fill-opacity={o} />)}
          </svg>

          <svg class="sky__grid" viewBox="0 0 620 620" aria-hidden="true">
            <circle cx="310" cy="310" r="100" class="sky__ring-dash" />
            <circle cx="310" cy="310" r="200" class="sky__ring-dash" />
            <circle cx="310" cy="310" r="300" class="sky__ring" />
            {radials.map(([x, y]) => <line x1="310" y1="310" x2={x} y2={y} class="sky__radial" />)}
            {ticks.map((t) => <line x1={t.x1} y1={t.y1} x2={t.x2} y2={t.y2} class="sky__tick" />)}
          </svg>

          {
            groups.map((g) => (
              <div
                class:list={['sky__glow', { 'is-extinct': g.extinct }]}
                style={`left: ${g.glow.left}; top: ${g.glow.top}; width: ${g.glow.width}; height: ${g.glow.height}; --c: ${g.color}`}
                aria-hidden="true"
              />
            ))
          }

          <svg class="sky__links" viewBox="0 0 620 620" aria-hidden="true">
            {links.map((l) => <line x1={l.x1} y1={l.y1} x2={l.x2} y2={l.y2} class:list={{ 'is-dashed': l.dashed }} style={`stroke: ${l.color}`} />)}
          </svg>

          {
            groups.map((g) => (
              <span class="sky__name" style={`left: ${pct(g.label[0])}; top: ${pct(g.label[1])}; --c: ${g.color}`} aria-hidden="true">
                {g.text.name}
              </span>
            ))
          }

          {
            approaching.map((a) => (
              <span class:list={['sky__approach', `is-${a.status}`, `is-${a.side}`]} style={`left: ${pct(a.x)}; top: ${pct(a.y)}`} aria-hidden="true">
                <span class="marker">
                  <span class="marker__ping" />
                  <span class="marker__ring" />
                  <span class="marker__dot" />
                </span>
                <span class="sky__approach-label">
                  {a.name} · {a.text.map}
                </span>
              </span>
            ))
          }

          {
            stars.map((s) => (
              <span
                class:list={['star', `lvl-${s.level}`, { 'is-extinct': s.extinct }]}
                style={`left: ${pct(s.x)}; top: ${pct(s.y)}; --c: ${s.color}; --delay: ${((s.index * 0.37) % 3.2).toFixed(2)}s`}
                data-star={s.index}
                aria-hidden="true">
                <span class="star__dot" />
              </span>
            ))
          }

          <span class="sky__caption" aria-hidden="true">{content.mapCaption}</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Element card: filled and moved by the script below -->
  <div class="card" id="inv-card" data-card hidden aria-live="polite">
    <div class="card__strip">
      <span>{content.card.title}</span>
      <span class="card__slot" aria-hidden="true"></span>
      <span data-f="num"></span>
    </div>
    <div class="card__head">
      <div class="card__designation">
        <span class="card__label">{content.card.designation}</span>
        <span class="card__name" data-f="name"></span>
        <span class="card__star" data-f="starLine"></span>
      </div>
      <span class="card__symbol" data-f="symbol" aria-hidden="true"></span>
    </div>
    <div class="card__log">
      <span class="card__label">{content.card.logbook}</span>
      <p data-f="description"></p>
    </div>
    <dl class="card__dl">
      <div data-if="since">
        <dt class="card__label">{content.card.experience}</dt>
        <dd><span data-f="since"></span> <span class="card__muted" data-f="years"></span></dd>
      </div>
      <div data-if="lastUsed">
        <dt class="card__label">{content.card.lastUsed}</dt>
        <dd class="card__last" data-last><span aria-hidden="true"></span><span data-f="lastUsed"></span></dd>
      </div>
      <div data-if="state">
        <dt class="card__label">{content.card.state}</dt>
        <dd data-f="state"></dd>
      </div>
      <div>
        <dt class="card__label">{content.card.sector}</dt>
        <dd data-f="sector"></dd>
      </div>
    </dl>
    <div class="card__missions" data-if="missions">
      <span class="card__label">{content.card.missions}</span>
      <ul data-missions></ul>
    </div>
    <div class="card__perf" aria-hidden="true"></div>
    <div class="card__foot">
      <div class="card__code">
        <canvas class="barcode barcode--tall card__barcode" data-barcode aria-hidden="true"></canvas>
        <span class="card__serial" data-f="serial"></span>
      </div>
      <a class="card__doc" data-doc target="_blank" rel="noopener noreferrer">
        <span>{content.card.documentation}</span>
        <span class="card__doc-url"><span data-f="urlLabel"></span> <span aria-hidden="true">↗</span></span>
      </a>
    </div>
  </div>

  <script type="application/json" data-sky-data set:html={JSON.stringify(stars.map((s) => s.card))} />
</section>

<script>
  import { drawBarcode } from '@/lib/barcode-draw';

  type Star = {
    name: string;
    symbol: string;
    starLine: string;
    description: string;
    since: string;
    years: string;
    lastUsed: string;
    current: boolean;
    state: string;
    sector: string;
    missions: string[];
    url: string;
    urlLabel: string;
    num: string;
    serial: string;
    barcode: string;
    group: string;
    color: string;
    side: 'left' | 'right';
    x: number;
    y: number;
  };

  for (const section of document.querySelectorAll<HTMLElement>('[data-inv]')) {
    const data: Star[] = JSON.parse(section.querySelector('[data-sky-data]')?.textContent ?? '[]');
    const card = section.querySelector<HTMLElement>('[data-card]')!;
    const sky = section.querySelector<HTMLElement>('[data-sky]')!;
    const chips = [...section.querySelectorAll<HTMLButtonElement>('button[data-star]')];
    const stars = [...section.querySelectorAll<HTMLElement>('.star[data-star]')];
    const desktop = window.matchMedia('(min-width: 1100px)');
    let active: number | null = null;
    let hideTimer: number | undefined;

    const place = (s: Star) => {
      if (!desktop.matches) {
        // Mobile: the card opens under its constellation's list
        section.querySelector(`[data-slot="${s.group}"]`)?.append(card);
        card.style.removeProperty('left');
        card.style.removeProperty('top');
        return;
      }
      sky.append(card);
      const size = sky.clientWidth;
      const scale = size / 620;
      const x = s.x * scale;
      const y = s.y * scale;
      const width = card.offsetWidth;
      const height = card.offsetHeight;
      card.style.left = `${s.side === 'right' ? x + 26 : x - 26 - width}px`;
      card.style.top = `${Math.max(0, Math.min(size - height, y - 70))}px`;
    };

    const show = (i: number) => {
      window.clearTimeout(hideTimer);
      if (active === i && !card.hidden) return;
      active = i;
      const s = data[i]!;
      for (const el of card.querySelectorAll<HTMLElement>('[data-f]')) el.textContent = String(s[el.dataset.f as keyof Star] ?? '');
      // Rows without data are hidden (e.g. no "since" year in sky.json)
      for (const el of card.querySelectorAll<HTMLElement>('[data-if]')) {
        const v = s[el.dataset.if as keyof Star];
        el.hidden = Array.isArray(v) ? v.length === 0 : !v;
      }
      card.querySelector<HTMLElement>('[data-last]')!.classList.toggle('is-current', s.current);
      const list = card.querySelector<HTMLElement>('[data-missions]')!;
      list.replaceChildren(
        ...s.missions.map((m) => {
          const li = document.createElement('li');
          li.textContent = m;
          return li;
        }),
      );
      card.querySelector<HTMLCanvasElement>('[data-barcode]')!.dataset.code = s.barcode;
      card.querySelector<HTMLAnchorElement>('[data-doc]')!.href = s.url;
      card.style.setProperty('--c', s.color);
      section.classList.add('has-active');
      for (const el of [...chips, ...stars]) {
        const on = Number(el.dataset.star) === i;
        el.classList.toggle('is-on', on);
        if (el instanceof HTMLButtonElement) el.setAttribute('aria-pressed', String(on));
      }
      card.hidden = false;
      card.classList.remove('is-in');
      void card.offsetWidth; // restart the entrance animation
      card.classList.add('is-in');
      place(s);
      drawBarcode(card.querySelector<HTMLCanvasElement>('[data-barcode]')!);
    };

    const hide = () => {
      active = null;
      card.hidden = true;
      section.classList.remove('has-active');
      for (const el of [...chips, ...stars]) {
        el.classList.remove('is-on');
        if (el instanceof HTMLButtonElement) el.setAttribute('aria-pressed', 'false');
      }
    };
    const hideSoon = () => {
      window.clearTimeout(hideTimer);
      hideTimer = window.setTimeout(hide, 220);
    };
    const keep = () => window.clearTimeout(hideTimer);

    for (const el of [...chips, ...stars]) {
      const i = Number(el.dataset.star);
      el.addEventListener('pointerenter', (e) => {
        if (e.pointerType === 'mouse' && desktop.matches) show(i);
      });
      el.addEventListener('pointerleave', (e) => {
        if (e.pointerType === 'mouse' && desktop.matches) hideSoon();
      });
    }
    for (const chip of chips) {
      const i = Number(chip.dataset.star);
      chip.addEventListener('focus', () => desktop.matches && show(i));
      chip.addEventListener('blur', () => desktop.matches && hideSoon());
      chip.addEventListener('click', () => {
        if (desktop.matches) show(i);
        else if (active === i) hide();
        else show(i);
      });
    }
    card.addEventListener('pointerenter', keep);
    card.addEventListener('pointerleave', () => desktop.matches && hideSoon());
    card.addEventListener('focusin', keep);
    card.addEventListener('focusout', () => desktop.matches && hideSoon());
    section.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && active !== null) hide();
    });
    desktop.addEventListener('change', hide);
  }
</script>

<style>
  .inv {
    position: relative;
    /* clip (not hidden): hidden would break the sticky sky map on mobile */
    overflow: clip;
    padding-block: var(--section-pad-top) var(--section-pad-bottom);
    background: var(--bg);
  }

  .inv__inner {
    display: flex;
    flex-direction: column;
    gap: clamp(16px, 3vh, 40px);
  }

  .inv__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 48px;
  }

  .inv__aside {
    display: flex;
    flex-direction: column;
    gap: 18px;
    max-width: 560px;
  }

  .inv__intro {
    margin: 0;
    font-size: 18px;
    line-height: 1.6;
    color: var(--text-soft);
  }

  .inv__intro-touch {
    display: none;
  }

  @media (hover: none) {
    .inv__intro-hover {
      display: none;
    }

    .inv__intro-touch {
      display: inline;
    }
  }

  /* ---------- Mastery bars ---------- */

  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 22px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-soft);
  }

  .legend li {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .rate {
    flex: none;
    display: flex;
    gap: 3px;
    margin-left: auto;
  }

  .rate span {
    display: block;
    width: 8px;
    height: 4px;
    border-radius: 2px;
    background: color-mix(in srgb, var(--text) 8%, transparent);
  }

  .rate span.is-on {
    background: var(--c);
  }

  .chip.is-on .rate span.is-on {
    box-shadow: 0 0 6px var(--c);
  }

  .rate--legend {
    --c: var(--text);
    margin-left: 0;
  }

  .rate--legend span {
    width: 10px;
    background: color-mix(in srgb, var(--text) 12%, transparent);
  }

  /* ---------- Layout ---------- */

  .inv__body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    gap: 28px;
    align-items: start;
  }

  .inv__col {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .inv__col--left {
    grid-column: 1;
    grid-row: 1;
  }

  .inv__col--right {
    grid-column: 3;
    grid-row: 1;
  }

  /* ---------- Lists ---------- */

  .group {
    padding: 14px 16px 8px;
    border: 1px solid color-mix(in srgb, var(--text) 9%, transparent);
    border-radius: 14px;
    background: color-mix(in srgb, var(--surface) 70%, transparent);
  }

  .group__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    margin-bottom: 4px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--line);
  }

  .group__title {
    display: flex;
    flex-direction: column;
    gap: 3px;
    margin: 0;
    font-weight: 400;
  }

  .group__label {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--c);
  }

  .group__name {
    font-size: 19px;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--text);
  }

  .group__meta {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .group__mini {
    width: 64px;
    height: 40px;
  }

  .group__mini line {
    stroke: var(--c);
    stroke-opacity: 0.55;
    stroke-width: 1;
  }

  .group__mini circle {
    fill: var(--c);
  }

  .is-extinct .group__mini line {
    stroke-dasharray: 2 2;
  }

  .is-extinct .group__mini circle {
    fill: none;
    stroke: var(--c);
    stroke-width: 0.8;
  }

  .group__count {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 2px;
  }

  .group__count-n {
    font-size: 19px;
    font-weight: 600;
    line-height: 1;
  }

  .group__count-label {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .is-extinct .group__name,
  .is-extinct .group__count-n {
    color: var(--text-soft);
  }

  .group__items {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-template-rows: repeat(var(--rows), auto);
    grid-auto-flow: column;
    column-gap: 18px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .group__items li {
    min-width: 0;
    border-top: 1px solid color-mix(in srgb, var(--text) 5%, transparent);
  }

  .group__items li.is-col-top {
    border-top: 0;
  }

  .chip {
    display: flex;
    align-items: center;
    gap: 9px;
    width: 100%;
    height: 29px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--text);
    font-size: 13px;
    text-align: left;
    cursor: pointer;
    transition: color 0.15s;
  }

  .is-extinct .chip {
    color: var(--text-faint);
  }

  .chip:hover,
  .chip.is-on {
    color: var(--c);
  }

  .chip__glyph {
    flex: none;
    display: flex;
    justify-content: center;
    width: 12px;
  }

  .chip__glyph svg {
    width: var(--g, 9px);
    height: var(--g, 9px);
    fill: var(--c);
    opacity: var(--go, 0.85);
    transition: opacity 0.15s;
  }

  .chip.lvl-3 .chip__glyph svg {
    --g: 12px;
    --go: 1;
    filter: drop-shadow(0 0 4px var(--c));
  }

  .chip.lvl-1 .chip__glyph svg {
    --g: 6.5px;
    --go: 0.6;
  }

  .chip.is-on .chip__glyph svg {
    opacity: 1;
    filter: drop-shadow(0 0 4px var(--c));
  }

  .is-extinct .chip__glyph svg {
    --g: 8px;
    fill: none;
    stroke: var(--c);
    stroke-width: 2;
    filter: none;
  }

  .chip__name {
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .group__slot:empty {
    display: none;
  }

  /* ---------- Stars in approach ---------- */

  .approach {
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 12px 16px;
    border: 1px dashed var(--line-strong);
    border-radius: 14px;
    white-space: nowrap;
  }

  .approach__label {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .approach__label-long,
  .approach__long {
    display: none;
  }

  .approach__list {
    display: flex;
    gap: 18px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .approach__item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
  }

  .approach__item.is-spotted {
    color: var(--text-soft);
  }

  .approach__short {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-soft);
  }

  .approach__item.is-spotted .approach__short {
    color: var(--text-faint);
  }

  /* Marker: a dashed ring (pulsing while being learnt) */
  .marker {
    --m: var(--text);
    position: relative;
    flex: none;
    display: block;
    width: 10px;
    height: 10px;
  }

  .is-spotted .marker {
    --m: var(--text-faint);
  }

  .marker > span {
    position: absolute;
    border-radius: 50%;
  }

  .marker__ping {
    inset: 0;
    display: none;
    border: 1px solid var(--m);
    animation: ping 2.4s ease-out infinite;
  }

  .is-learning .marker__ping {
    display: block;
  }

  .marker__ring {
    inset: 0;
    border: 1px dashed var(--m);
  }

  .marker__dot {
    display: none;
    left: 50%;
    top: 50%;
    width: 3px;
    height: 3px;
    margin: -1.5px 0 0 -1.5px;
    background: var(--m);
  }

  @keyframes ping {
    0% {
      transform: scale(0.6);
      opacity: 0.9;
    }
    100% {
      transform: scale(2.2);
      opacity: 0;
    }
  }

  /* ---------- Sky map ---------- */

  .sky-wrap {
    grid-column: 2;
    grid-row: 1;
  }

  .sky {
    position: relative;
    /* Shrinks with the window so the lists keep room and the section fits on screen */
    width: clamp(320px, min(36vw, calc(100svh - 300px)), 520px);
    aspect-ratio: 1;
  }

  .sky__disc {
    position: absolute;
    inset: 1.6%;
    border-radius: 50%;
    background: radial-gradient(circle at 50% 45%, var(--map-core), var(--map-edge) 75%);
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--text) 6%, transparent),
      0 0 120px -30px color-mix(in srgb, var(--star-blue) 25%, transparent);
  }

  .sky > svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .sky__field {
    fill: var(--text);
    animation: spin 240s linear infinite;
  }

  .sky__grid {
    fill: none;
  }

  .sky__ring-dash {
    stroke: color-mix(in srgb, var(--text) 5%, transparent);
    stroke-dasharray: 2 6;
  }

  .sky__ring {
    stroke: color-mix(in srgb, var(--text) 10%, transparent);
  }

  .sky__radial {
    stroke: color-mix(in srgb, var(--text) 4%, transparent);
  }

  .sky__tick {
    stroke: color-mix(in srgb, var(--text) 18%, transparent);
  }

  .sky__glow {
    position: absolute;
    border-radius: 50%;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--c) 15%, transparent), transparent);
    pointer-events: none;
  }

  .sky__glow.is-extinct {
    background: radial-gradient(closest-side, color-mix(in srgb, var(--c) 10%, transparent), transparent);
  }

  .sky__links line {
    stroke-opacity: 0.4;
    stroke-width: 1;
  }

  .sky__links line.is-dashed {
    stroke-opacity: 0.45;
    stroke-dasharray: 3 4;
  }

  .sky__name {
    position: absolute;
    transform: translateX(-50%);
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--c);
    opacity: 0.75;
    pointer-events: none;
  }

  .sky__approach {
    position: absolute;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    margin: -9px 0 0 -9px;
    pointer-events: none;
  }

  .sky__approach .marker {
    width: 18px;
    height: 18px;
  }

  .sky__approach .marker__dot {
    display: block;
  }

  .sky__approach-label {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--text);
  }

  .sky__approach.is-right .sky__approach-label {
    left: 24px;
  }

  .sky__approach.is-left .sky__approach-label {
    right: 24px;
  }

  .sky__approach.is-spotted .sky__approach-label {
    color: var(--text-muted);
  }

  .star {
    --d: 8px;
    --o: 0.9;
    --glow: 0 0 10px 2px;
    position: absolute;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    margin: -14px 0 0 -14px;
    cursor: pointer;
    transition: opacity 0.2s;
  }

  .star.lvl-3 {
    --d: 13px;
    --o: 1;
    --glow: 0 0 18px 4px;
  }

  .star.lvl-1 {
    --d: 5px;
    --o: 0.6;
    --glow: 0 0 5px 1px;
  }

  .star__dot {
    width: var(--d);
    height: var(--d);
    border-radius: 50%;
    background: var(--c);
    box-shadow: var(--glow) var(--c);
    opacity: var(--o);
    animation: twinkle 3.2s ease-in-out infinite;
    animation-delay: var(--delay);
    transition: all 0.2s;
  }

  /* Extinct stars: an empty ring, all the same size (no mastery level any more) */
  .star.is-extinct .star__dot {
    width: 7px;
    height: 7px;
    border: 1.5px solid var(--c);
    background: transparent;
    box-shadow: none;
    --o: 0.85;
  }

  .has-active .star:not(.is-on) {
    opacity: 0.45;
  }

  .star.is-on .star__dot {
    width: 18px;
    height: 18px;
    border: 0;
    background: #fff;
    box-shadow: 0 0 28px 6px var(--c);
    opacity: 1;
    animation: none;
  }

  :global([data-theme='light']) .star.is-on .star__dot {
    background: var(--text);
  }

  @keyframes twinkle {
    50% {
      opacity: calc(var(--o) * 0.55);
    }
  }

  .sky__caption {
    position: absolute;
    left: 50%;
    bottom: -6px;
    transform: translateX(-50%);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--text-faint);
  }

  /* ---------- Element card ---------- */

  .card {
    position: absolute;
    z-index: 5;
    width: 300px;
    overflow: hidden;
    border: 1px solid var(--line-dashed);
    border-radius: 16px;
    background: linear-gradient(160deg, var(--surface-raised), var(--surface) 60%);
    box-shadow:
      0 30px 60px -20px var(--shadow-color),
      0 0 50px -16px var(--c);
  }

  .card[hidden],
  .card [hidden] {
    display: none;
  }

  .card.is-in {
    animation: card-in 0.2s ease-out;
  }

  @keyframes card-in {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
  }

  .card__strip {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 11px 18px;
    background: var(--c);
    color: var(--bg);
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .card__slot {
    width: 26px;
    height: 6px;
    border-radius: 99px;
    background: var(--bg);
  }

  .card__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 12px;
    padding: 18px 18px 14px;
  }

  .card__designation {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .card__label,
  .card__star {
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .card__name {
    font-size: 22px;
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .card__symbol {
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 58px;
    height: 58px;
    border: 1.5px solid var(--c);
    border-radius: 10px;
    background: color-mix(in srgb, var(--c) 8%, transparent);
    color: var(--c);
    font-size: 26px;
    font-weight: 700;
    letter-spacing: -0.04em;
  }

  .card__log {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin: 0 18px;
    padding: 12px 14px;
    border-radius: 10px;
    background: color-mix(in srgb, var(--text) 4%, transparent);
  }

  .card__log p {
    margin: 0;
    font-size: 14px;
    line-height: 1.5;
    color: var(--text);
  }

  .card__dl {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px 14px;
    margin: 14px 0 0;
    padding: 0 18px;
  }

  .card__dl dt {
    margin-bottom: 4px;
  }

  .card__dl dd {
    margin: 0;
    font-size: 13px;
  }

  .card__muted {
    color: var(--text-muted);
  }

  /* Last used: green while still in use */
  .card__last {
    --tone: var(--text-faint);
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--text-soft);
  }

  .card__last.is-current {
    --tone: var(--success);
    color: var(--success);
  }

  .card__last > span:first-child {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--tone);
  }

  .card__missions {
    display: flex;
    flex-direction: column;
    gap: 7px;
    margin-top: 14px;
    padding: 0 18px;
  }

  .card__missions ul {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Mission chips are created by the script: :global so the scoped styles reach them */
  .card__missions :global(li) {
    padding: 4px 9px;
    border: 1px solid color-mix(in srgb, var(--c) 33%, transparent);
    border-radius: 999px;
    background: color-mix(in srgb, var(--c) 7%, transparent);
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.06em;
    white-space: nowrap;
  }

  .card__perf {
    position: relative;
    margin-top: 16px;
    border-top: 1px dashed var(--line-strong);
  }

  .card__perf::before,
  .card__perf::after {
    content: '';
    position: absolute;
    top: -9px;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--map-edge);
  }

  .card__perf::before {
    left: -9px;
  }

  .card__perf::after {
    right: -9px;
  }

  .card__foot {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 14px 18px;
  }

  .card__code {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
  }


  .card__serial {
    white-space: nowrap;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    color: var(--text-muted);
  }

  .card__doc {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    min-height: 32px;
    padding-top: 10px;
    border-top: 1px solid var(--line-dashed);
    color: var(--text-soft);
    font-size: 12.5px;
    font-weight: 500;
    text-decoration: none;
    transition: color 0.2s;
  }

  .card__doc:hover {
    color: var(--c);
  }

  .card__doc-url {
    min-width: 0;
    overflow: hidden;
    font-family: var(--font-mono);
    font-size: 11px;
    white-space: nowrap;
    text-overflow: ellipsis;
    opacity: 0.85;
  }

  /* ---------- Narrow desktop ---------- */

  @media (min-width: 1100px) and (max-width: 1279px) {
    .inv__body {
      gap: 20px;
    }

    .group {
      padding-inline: 12px;
    }

    .group__mini {
      display: none;
    }

    .group__items {
      column-gap: 12px;
    }
  }

  /* ---------- Tablet & mobile ---------- */

  @media (max-width: 1099px) {
    .inv {
      border-top: 1px solid var(--line);
    }

    .inv__inner {
      gap: 24px;
    }

    .inv__head {
      flex-direction: column;
      align-items: stretch;
      gap: 24px;
    }

    .inv__intro {
      font-size: 15px;
    }

    .legend {
      gap: 8px 16px;
      font-size: 10.5px;
    }

    .rate--legend {
      gap: 4px;
    }

    /* One column: the constellations follow each other in file order */
    .inv__body {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 24px;
    }

    .inv__col {
      display: contents;
    }

    /* The sky sits behind the lists and stays in view while scrolling them */
    .sky-wrap {
      order: -1;
      position: sticky;
      top: calc(var(--header-h) + 16px);
      z-index: 0;
      align-self: center;
      width: min(350px, 100%);
      margin-bottom: max(-354px, calc(-94vw - 24px));
      pointer-events: none;
      opacity: 0.45;
      transition: opacity 0.3s;
    }

    .has-active .sky-wrap {
      opacity: 0.9;
    }

    .sky {
      width: 100%;
    }

    .sky__caption,
    .sky__name,
    .sky__approach-label {
      display: none;
    }

    .group,
    .approach {
      position: relative;
      z-index: 1;
    }

    .group {
      padding: 0;
      border: 0;
      border-radius: 0;
      background: none;
    }

    .group__head {
      margin-bottom: 6px;
      padding-bottom: 0;
      border: 0;
    }

    .group__title {
      flex-direction: row;
      gap: 0;
      font-family: var(--font-mono);
      font-size: 10px;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--c);
    }

    .group__label::after {
      content: ' · ';
      white-space: pre;
    }

    .group__label,
    .group__name {
      font: inherit;
      letter-spacing: inherit;
      color: inherit;
    }

    .is-extinct .group__name {
      color: inherit;
    }

    .group__meta {
      display: none;
    }

    .group__items {
      grid-template-rows: none;
      grid-auto-flow: row;
    }

    .group__items li,
    .group__items li.is-col-top {
      border-top: 0;
    }

    .chip {
      justify-content: space-between;
      gap: 10px;
      height: auto;
      min-height: 36px;
      padding: 6px 0;
      font-size: 14.5px;
    }

    .chip__glyph {
      display: none;
    }

    .group[data-group='tools'] .chip:not(.is-on) {
      color: var(--text-soft);
    }

    .rate span {
      width: 10px;
    }

    .approach {
      flex-direction: column;
      align-items: stretch;
      gap: 12px;
      padding: 14px 16px;
      border-radius: 12px;
      background: color-mix(in srgb, var(--text) 2.5%, transparent);
      white-space: normal;
    }

    .approach__label-short,
    .approach__short {
      display: none;
    }

    .approach__label-long {
      display: inline;
    }

    .approach__list {
      flex-direction: column;
      gap: 12px;
    }

    .approach__item {
      gap: 12px;
    }

    .approach .marker {
      width: 14px;
      height: 14px;
    }

    .approach .marker__dot {
      display: block;
    }

    .approach__name {
      font-size: 15px;
      font-weight: 600;
    }

    .approach__long {
      display: flex;
      flex-direction: column;
      gap: 2px;
      margin-left: auto;
      text-align: right;
    }

    .approach__status {
      font-family: var(--font-mono);
      font-size: 10px;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--text);
    }

    .is-spotted .approach__status {
      color: var(--text-muted);
    }

    .approach__note {
      font-size: 12px;
      color: var(--text-muted);
    }

    .card {
      position: static;
      width: auto;
      margin-top: 10px;
      border-radius: 14px;

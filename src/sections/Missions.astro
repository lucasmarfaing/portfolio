---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Redactable from '@/components/Redactable.astro';
import SectionHead from '@/components/SectionHead.astro';
import { fill, type MissionsContent } from '@/lib/content';

interface Props {
  content: MissionsContent;
}

const { content } = Astro.props;
const { labels } = content;

// Mission screenshots live in src/assets/missions/ so Astro can optimise them
const screenshots = import.meta.glob<{ default: ImageMetadata }>('/src/assets/missions/**/*.{png,jpg,jpeg,webp,avif}', {
  eager: true,
});
const screenshotFor = (file?: string) => {
  if (!file) return undefined;
  const found = screenshots[`/src/assets/missions/${file}`];
  if (!found) throw new Error(`Capture introuvable : src/assets/missions/${file} (champ "image" de missions.json)`);
  return found.default;
};

/**
 * Gallery: every image of a folder, spread over 5 scrolling columns.
 * Each column repeats its images so the loop (translateY -25 %) is seamless.
 */
const galleryFor = (folder?: string) => {
  if (!folder) return undefined;
  const prefix = `/src/assets/missions/${folder}/`;
  const images = Object.keys(screenshots)
    .filter((path) => path.startsWith(prefix))
    .sort()
    .map((path) => screenshots[path]!.default);
  if (images.length === 0) throw new Error(`Galerie vide : src/assets/missions/${folder}/ (champ "gallery" de missions.json)`);
  // Phone screenshots (portrait) get narrower tiles and more columns, so the plane is as wide
  const portrait = images[0]!.height > images[0]!.width;
  const columnCount = portrait ? 7 : 5; // wide enough that the tilted plane always covers the whole screen
  const columns = Array.from({ length: columnCount }, (_, c) => {
    const base = images.map((_, i) => images[(i + c * 2) % images.length]!);
    // One loop = 6 tiles (5 taller phone tiles). The column holds 4 loops and scrolls by one (25 %),
    // so the visible window always stays in the middle of the tiles: never an empty edge.
    const loop = Array.from({ length: portrait ? 5 : 6 }, (_, i) => base[(i + c) % base.length]!);
    return [...loop, ...loop, ...loop, ...loop];
  });
  return { portrait, columns };
};

const tintVar = { red: 'var(--accent)', amber: 'var(--warning)', blue: 'var(--star-blue)' } as const;
const statusColor = {
  done: 'var(--success)',
  live: 'var(--warning)',
  archived: 'var(--text-muted)',
  secret: 'var(--accent)',
} as const;

// Activity chart (SVG 520 × 104)
const CW = 520;
const CH = 100;
const chart = (values: number[]) => {
  const max = Math.max(...values, 1);
  const pts = values.map((v, i) => [Math.round((i * CW) / (values.length - 1)), Math.round(CH - 4 - (v / max) * (CH - 14))] as const);
  const line = `M${pts.map((p) => p.join(' ')).join(' L')}`;
  const last3 = values.slice(-3).reduce((a, b) => a + b, 0);
  const prev3 = values.slice(-6, -3).reduce((a, b) => a + b, 0);
  return { line, area: `${line} L${CW} 104 L0 104 Z`, last: pts.at(-1)!, up: last3 >= prev3 };
};

const { units } = labels;
const plural = (n: number, one: string, many: string) => `${n} ${n > 1 ? many : one}`;

/** The same three meters for every mission, computed from its data sheet (12 cells each). */
const metersFor = (m: MissionsContent['missions'][number]) => {
  if (m.status === 'secret') {
    return [labels.meters.duration, labels.meters.crew, labels.meters.technos].map((label, k) => ({
      label,
      value: '█'.repeat(5 - k),
      level: 0,
    }));
  }
  const technoCount = m.stack.split('·').filter((t) => t.trim()).length;
  const months = m.months;
  const duration =
    months === undefined
      ? '—'
      : months < 12
        ? plural(months, units.month, units.months)
        : plural(Math.round(months / 12), units.year, units.years);
  return [
    // 4 months per cell: 12 cells = 4 years
    { label: labels.meters.duration, value: duration, level: months ? Math.min(12, Math.ceil(months / 4)) : 0 },
    {
      label: labels.meters.crew,
      value: m.crewSize === undefined ? '—' : m.crewSize === 1 ? units.solo : fill(units.people, { n: m.crewSize }),
      level: Math.min(12, m.crewSize ?? 0),
    },
    { label: labels.meters.technos, value: String(technoCount), level: Math.min(12, technoCount) },
  ];
};

const missions = content.missions.map((m, i) => {
  const secret = m.status === 'secret';
  const finished = m.status === 'done' || m.status === 'archived';
  const step = finished ? 4 : (m.phase ?? 1);
  const accent = secret ? 'var(--accent)' : m.status === 'archived' ? 'var(--text-muted)' : finished ? 'var(--accent)' : 'var(--warning)';
  const activity = m.activity ? chart(m.activity) : undefined;
  const progressPct = finished ? 100 : step * 25;
  const phases = labels.phases.map((label, p) => {
    if (secret) return { label: p === 0 ? `✓ ${label}` : '█'.repeat(6 + p * 2), state: p === 0 ? 'done' : 'redacted' };
    const state = p < step ? 'done' : p === step ? 'current' : 'todo';
    return { label: `${state === 'done' ? '✓ ' : state === 'current' ? '● ' : ''}${label}`, state };
  });
  const rows = [
    { key: labels.rows.status, value: labels.statusLong[m.status], color: statusColor[m.status] },
    { key: labels.rows.role, value: m.role },
    { key: labels.rows.stack, value: m.stack },
    ...(m.launch ? [{ key: labels.rows.launch, value: m.launch }] : []),
    ...(m.duration ? [{ key: labels.rows.duration, value: m.duration }] : []),
    { key: labels.rows.crew, value: m.crew },
  ];
  return {
    ...m,
    id: `mission-${i}`,
    num: secret ? '??' : String(i + 1).padStart(2, '0'),
    secret,
    accent,
    statusColor: statusColor[m.status],
    tint: tintVar[m.tint],
    progress: secret ? '███' : `${progressPct} %`,
    phases,
    rows,
    activity,
    trend: secret
      ? labels.trend.secret
      : !activity
        ? labels.trend.none
        : m.status === 'archived'
          ? labels.trend.ended
          : activity.up
            ? labels.trend.up
            : labels.trend.down,
    trendColor: secret
      ? 'var(--accent)'
      : !activity || m.status === 'archived'
        ? 'var(--text-muted)'
        : activity.up
          ? 'var(--success)'
          : 'var(--accent-alt)',
    // Progress gauge: same scale as the phases (25 % per phase, 100 % when finished)
    gauge: secret ? '??' : `${progressPct}%`,
    gaugeDash: secret || progressPct === 0 ? undefined : `${Math.round((245 * progressPct) / 100)} 400`,
    meters: metersFor(m),
    screenshot: screenshotFor(m.image),
    gallery: galleryFor(m.gallery),
  };
});
---

<section id="missions" class="mis" aria-labelledby="mis-title" data-missions>
  <div class="container mis__inner">
    <div class="mis__head">
      <SectionHead id="mis-title" index={content.index} label={content.label} title={content.title} titleMuted={content.titleMuted} />
      <p class="mis__intro">{content.intro}</p>
    </div>

    <div class="mis__body">
      <div class="mis__tabs" role="tablist" aria-label={content.label} aria-orientation="vertical">
        {
          missions.map((m, i) => (
            <button
              type="button"
              role="tab"
              id={`${m.id}-tab`}
              class:list={['tab', { 'is-secret': m.secret }]}
              aria-selected={i === 0 ? 'true' : 'false'}
              aria-controls={m.id}
              tabindex={i === 0 ? 0 : -1}
              data-tab={i}>
              <span class="tab__patch">{m.num}</span>
              <span class="tab__text">
                <span class="tab__name">
                  <Redactable text={m.name} />
                </span>
                <span class="tab__cat">{m.category}</span>
              </span>
              <span class="tab__status" style={`--sc: ${m.statusColor}`}>
                <span class="tab__status-dot" aria-hidden="true" />
                {labels.status[m.status]}
              </span>
            </button>
          ))
        }
      </div>

      <div class="mis__panels">
        {
          missions.map((m, i) => (
            <div
              role="tabpanel"
              id={m.id}
              aria-labelledby={`${m.id}-tab`}
              class:list={['panel', { 'is-active': i === 0, 'is-secret': m.secret, 'is-archived': m.status === 'archived' }]}
              style={`--ac: ${m.accent}; --tint: ${m.tint}`}
              data-panel={i}>
              <!-- "Video feed" -->
              <div class="screen">
                {(m.secret || m.screen === 'encrypted') && <div class="screen__noise" aria-hidden="true" />}
                <span class="screen__scan" aria-hidden="true" />
                <div class="screen__top">
                  <span>
                    {labels.feed} {m.num}
                  </span>
                  <span class="screen__meta">
                    <span class="screen__elapsed">T+ {m.elapsed}</span>
                    <span style={`color: ${m.secret ? 'var(--accent)' : m.statusColor}`}>
                      {labels.progress} {m.progress}
                    </span>
                    <span class="screen__rec">
                      <span aria-hidden="true" />
                      {labels.rec}
                    </span>
                  </span>
                </div>
                {m.gallery ? (
                  <div class:list={['mosaic', { 'mosaic--portrait': m.gallery.portrait }]} role="img" aria-label={m.screenshotLabel}>
                    <div class="mosaic__plane">
                      {m.gallery.columns.map((column, c) => (
                        <div class:list={['mosaic__col', `mosaic__col--${c + 1}`]}>
                          {column.map((shot) => (
                            /* Not lazy: tiles scroll into view constantly, a lazy tile would appear empty for a moment */
                            <Image
                              class="mosaic__tile"
                              src={shot}
                              alt=""
                              widths={m.gallery!.portrait ? [200, 320] : [320, 480]}
                              sizes={m.gallery!.portrait ? '160px' : '240px'}
                              loading="eager"
                              decoding="async"
                              fetchpriority="low"
                            />
                          ))}
                        </div>
                      ))}
                    </div>
                  </div>
                ) : m.screenshot ? (
                  <Image
                    class="screen__img"
                    src={m.screenshot}
                    alt={m.screenshotLabel}
                    widths={[640, 1080, 1440]}
                    sizes="(max-width: 1099px) 100vw, 1080px"
                    loading="lazy"
                  />
                ) : (
                  <span class="screen__placeholder">{m.screenshotLabel}</span>
                )}
                {m.status === 'archived' && (
                  <div class="stamp stamp--archived">
                    <span class="stamp__main">{labels.archivedStamp}</span>
                    <span class="stamp__sub">{labels.archivedStampSub}</span>
                  </div>
                )}
                {m.secret && (
                  <div class="stamp stamp--secret">
                    <span class="stamp__main">{labels.secretStamp}</span>
                    <span class="stamp__sub">{labels.secretStampSub}</span>
                  </div>
                )}
                <ol class="phases">
                  {m.phases.map((p) => (
                    <li class:list={['phase', `is-${p.state}`]}>
                      <span class="phase__bar" aria-hidden="true" />
                      <span class="phase__label">{p.label}</span>
                    </li>
                  ))}
                </ol>
                <span class="corner corner--tl" aria-hidden="true" />
                <span class="corner corner--tr" aria-hidden="true" />
                <span class="corner corner--bl" aria-hidden="true" />
                <span class="corner corner--br" aria-hidden="true" />
              </div>

              <div class="details">
                <div class="details__info">
                  <div class="details__title">
                    <h3>
                      <Redactable text={m.name} />
                    </h3>
                    <span class="details__cat">{m.category}</span>
                  </div>
                  <p class="details__brief">
                    <Redactable text={m.brief} />
                  </p>
                  <div class="details__ctas">
                    {m.secret ? (
                      <>
                        <a class="btn-cta" href="#contact">
                          {labels.requestAccess} <span aria-hidden="true">↗</span>
                        </a>
                        <span class="btn-ghost is-denied" aria-disabled="true">
                          {labels.accessDenied}
                        </span>
                      </>
                    ) : (
                      <>
                        {m.links?.mission && (
                          <a class="btn-cta" href={m.links.mission} target="_blank" rel="noopener noreferrer">
                            {labels.viewMission} <span aria-hidden="true">↗</span>
                          </a>
                        )}
                        {m.links?.source && (
                          <a class="btn-ghost" href={m.links.source} target="_blank" rel="noopener noreferrer">
                            {labels.source}
                          </a>
                        )}
                      </>
                    )}
                  </div>
                </div>
                <dl class="details__rows">
                  {m.rows.map((r) => (
                    <div>
                      <dt>{r.key}</dt>
                      <dd style={r.color ? `color: ${r.color}` : undefined}>
                        <Redactable text={r.value} />
                      </dd>
                    </div>
                  ))}
                </dl>
              </div>

              <div class="widgets" aria-hidden="true">
                <div class="widget widget--gauge">
                  <span class="widget__label">{labels.gauge}</span>
                  <div class="gauge">
                    <svg viewBox="0 0 140 140">
                      <circle cx="70" cy="70" r="52" class="gauge__track" stroke-dasharray="245 400" transform="rotate(135 70 70)" />
                      {/* No value arc at 0 %: a zero-length round-capped stroke would draw a stray dot */}
                      {m.gaugeDash && (
                        <circle cx="70" cy="70" r="52" class="gauge__value" stroke-dasharray={m.gaugeDash} transform="rotate(135 70 70)" />
                      )}
                    </svg>
                    <div class="gauge__text">
                      <span class:list={['gauge__number', { 'is-empty': m.secret }]}>{m.gauge}</span>
                      <span class="gauge__unit">{labels.gaugeUnit}</span>
                    </div>
                  </div>
                </div>

                <div class="widget widget--chart">
                  <div class="widget__row">
                    <span class="widget__label">{labels.activity}</span>
                    <span class="widget__trend" style={`color: ${m.trendColor}`}>
                      {m.trend}
                    </span>
                  </div>
                  <div class="chart-box">
                    <svg class="chart" viewBox="0 0 520 104" preserveAspectRatio="none">
                      <line x1="0" y1="26" x2="520" y2="26" />
                      <line x1="0" y1="52" x2="520" y2="52" />
                      <line x1="0" y1="78" x2="520" y2="78" />
                      {m.activity ? (
                        <>
                          <path d={m.activity.area} class="chart__area" />
                          <path d={m.activity.line} class="chart__line" vector-effect="non-scaling-stroke" />
                        </>
                      ) : (
                        <line x1="0" y1="96" x2="520" y2="96" class="chart__empty" vector-effect="non-scaling-stroke" />
                      )}
                    </svg>
                    {!m.activity && <span class="chart__missing">{labels.activityMissing}</span>}
                  </div>
                  <div class="widget__months">
                    {labels.months.map((mo) => (
                      <span>{mo}</span>
                    ))}
                  </div>
                </div>

                <div class="widget widget--meters">
                  {m.meters.map((mt) => (
                    <div class="meter">
                      <div class="meter__row">
                        <span class="widget__label">{mt.label}</span>
                        <span class="meter__value">
                          <Redactable text={mt.value} />
                        </span>
                      </div>
                      <div class="meter__cells">
                        {Array.from({ length: 12 }, (_, c) => (
                          <span class:list={{ 'is-on': c < mt.level }} />
                        ))}
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  for (const section of document.querySelectorAll<HTMLElement>('[data-missions]')) {
    const tabs = [...section.querySelectorAll<HTMLButtonElement>('[data-tab]')];
    const panels = [...section.querySelectorAll<HTMLElement>('[data-panel]')];

    const select = (index: number, focus = false) => {
      const i = (index + tabs.length) % tabs.length;
      tabs.forEach((t, k) => {
        t.setAttribute('aria-selected', String(k === i));
        t.tabIndex = k === i ? 0 : -1;
      });
      panels.forEach((p, k) => p.classList.toggle('is-active', k === i));
      if (focus) tabs[i]?.focus();
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(i));
      tab.addEventListener('keydown', (e) => {
        const keys: Record<string, number> = { ArrowDown: i + 1, ArrowRight: i + 1, ArrowUp: i - 1, ArrowLeft: i - 1, Home: 0, End: tabs.length - 1 };
        if (e.key in keys) {
          e.preventDefault();
          select(keys[e.key]!, true);
        }
      });
    });
  }
</script>

<style>
  .mis {
    position: relative;
    padding-block: var(--section-pad-top) var(--section-pad-bottom);
    background: var(--bg);
  }

  .mis__inner {
    display: flex;
    flex-direction: column;
    gap: clamp(16px, 3vh, 48px);
  }

  .mis__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 48px;
  }

  .mis__intro {
    margin: 0;
    max-width: 400px;
    font-size: 18px;
    line-height: 1.6;
    color: var(--text-soft);
  }

  .mis__body {
    display: grid;
    grid-template-columns: minmax(280px, 380px) minmax(0, 1fr);
    gap: 32px;
    align-items: start;
  }

  /* ---------- Tabs ---------- */

  .mis__tabs {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .tab {
    display: flex;
    align-items: center;
    gap: 16px;
    width: 100%;
    min-height: clamp(68px, 9vh, 88px);
    padding: 14px 20px;
    border: 1px solid color-mix(in srgb, var(--text) 9%, transparent);
    border-radius: 14px;
    background: var(--surface);
    color: var(--text);
    text-align: left;
    cursor: pointer;
    transition: background-color 0.2s, border-color 0.2s;
  }

  .tab:hover {
    border-color: color-mix(in srgb, var(--accent) 45%, transparent);
  }

  .tab[aria-selected='true'] {
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 7%, var(--surface));
  }

  .tab__patch {
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border: 1.5px solid color-mix(in srgb, var(--accent) 45%, transparent);
    border-radius: 50%;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 500;
  }

  .tab.is-secret .tab__patch {
    border-style: dashed;
    border-color: var(--accent);
  }

  .tab[aria-selected='true'] .tab__patch {
    border: 0;
    background: var(--accent);
    color: var(--on-accent);
  }

  .tab__text {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
    min-width: 0;
  }

  .tab__name {
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .tab__cat {
    font-size: 13px;
    color: var(--text-muted);
  }

  .tab__status {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--sc);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .tab__status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--sc);
  }

  /* ---------- Panels (stacked: the box keeps the tallest height, nothing jumps) ---------- */

  .mis__panels {
    display: grid;
  }

  .panel {
    grid-area: 1 / 1;
    display: flex;
    flex-direction: column;
    gap: clamp(12px, 2vh, 20px);
    visibility: hidden;
  }

  .panel.is-active {
    visibility: visible;
  }

  .panel.is-active .screen {
    animation: screen-in 0.35s ease;
  }

  @keyframes screen-in {
    from {
      opacity: 0.3;
    }
  }

  /* ---------- Video feed ---------- */

  .screen {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    height: clamp(150px, 21vh, 360px);
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--text) 9%, transparent);
    border-radius: 16px;
    background: radial-gradient(600px 300px at 70% 20%, color-mix(in srgb, var(--tint) 16%, transparent), var(--surface) 70%);
  }

  .is-secret .screen {
    background: radial-gradient(600px 300px at 70% 20%, color-mix(in srgb, var(--tint) 10%, transparent), var(--surface) 70%);
  }

  .screen__noise {
    position: absolute;
    inset: 0;
    z-index: 1;
    background-image:
      repeating-linear-gradient(0deg, color-mix(in srgb, var(--text) 5%, transparent) 0 1px, transparent 1px 3px),
      repeating-linear-gradient(90deg, color-mix(in srgb, var(--accent) 4%, transparent) 0 2px, transparent 2px 5px);
    animation: noise 0.25s steps(2) infinite;
  }

  @keyframes noise {
    50% {
      background-position:
        0 2px,
        3px 0;
    }
  }

  .screen__scan {
    position: absolute;
    left: 0;
    right: 0;
    z-index: 2;
    height: 60px;
    background: linear-gradient(transparent, color-mix(in srgb, var(--text) 5%, transparent), transparent);
    pointer-events: none;
    animation: scan 3.5s linear infinite;
  }

  @keyframes scan {
    from {
      top: -60px;
    }
    to {
      top: 100%;
    }
  }

  .screen__top {
    position: absolute;
    top: 18px;
    left: 22px;
    right: 22px;
    z-index: 2;
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .screen__meta {
    display: flex;
    align-items: center;
    gap: 18px;
  }

  .screen__rec {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .screen__rec span {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    animation: blink 1.6s ease-in-out infinite;
  }

  .screen__placeholder {
    padding: 14px 20px;
    border: 1px dashed var(--line-strong);
    border-radius: 10px;
    font-size: 15px;
    color: var(--text-muted);
  }

  /* The "Mission ended" stamp replaces the placeholder text on archived missions */
  .is-archived .screen__placeholder {
    visibility: hidden;
  }

  /* Archived mission: the feed fades slightly, like an old recording */
  .is-archived .mosaic {
    filter: grayscale(0.85) brightness(0.85);
  }


  /* Screenshot shown like a video feed: slightly dimmed so the overlays stay readable */
  .screen :global(.screen__img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 45%;
    opacity: 0.55;
  }

  /* ---------- Gallery: tilted mosaic of pages, slowly scrolling ---------- */

  .mosaic {
    position: absolute;
    inset: 0;
    overflow: hidden;
    perspective: 1400px;
  }

  .mosaic {
    --tile-w: 240px;
    --cols: 5;
  }

  /* Phone screenshots: narrower, taller tiles, more columns */
  .mosaic--portrait {
    --tile-w: 160px;
    --cols: 7;
  }

  .mosaic__plane {
    position: absolute;
    top: 50%;
    left: 50%;
    display: grid;
    grid-template-columns: repeat(var(--cols), var(--tile-w));
    gap: 18px;
    transform: translate(-50%, -50%) rotateX(38deg) rotateZ(-24deg);
    transform-style: preserve-3d;
  }

  .mosaic__col {
    display: flex;
    flex-direction: column;
    gap: 18px;
    animation: mosaic-up 46s linear infinite;
  }

  /* Every other column goes the other way, each at its own speed */
  .mosaic__col--2,
  .mosaic__col--4 {
    animation-name: mosaic-down;
    animation-duration: 54s;
  }

  .mosaic__col--3 {
    animation-duration: 40s;
  }

  .mosaic__col--4 {
    animation-duration: 60s;
  }

  .mosaic__col--5 {
    animation-duration: 50s;
  }

  .mosaic__col--6 {
    animation-name: mosaic-down;
    animation-duration: 48s;
  }

  .mosaic__col--7 {
    animation-duration: 56s;
  }

  .mosaic :global(.mosaic__tile) {
    display: block;
    width: var(--tile-w);
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top;
    border: 1px solid color-mix(in srgb, var(--text) 14%, transparent);
    border-radius: 8px;
    box-shadow: 0 18px 40px -18px var(--shadow-color);
    opacity: 0.85;
  }

  /* Phone screens keep their own shape (rounded frame included) */
  .mosaic--portrait :global(.mosaic__tile) {
    aspect-ratio: auto;
    border: 0;
    border-radius: 0;
    box-shadow: none;
    filter: drop-shadow(0 14px 24px var(--shadow-color));
  }

  /* One loop = a quarter of the column (it holds 4 identical loops) */
  @keyframes mosaic-up {
    from {
      transform: translateY(0);
    }
    to {
      transform: translateY(-25%);
    }
  }

  @keyframes mosaic-down {
    from {
      transform: translateY(-25%);
    }
    to {
      transform: translateY(0);
    }
  }

  .screen:has(.mosaic)::after,
  .screen:has(.screen__img)::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(180deg, color-mix(in srgb, var(--surface) 70%, transparent), transparent 30%, transparent 60%, color-mix(in srgb, var(--surface) 85%, transparent));

---
import { Image } from 'astro:assets';
import portrait from '@/assets/images/portrait.png';
import Icon from '@/components/Icon.astro';
import SectionHead from '@/components/SectionHead.astro';
import { barcodePath, labelBarcode } from '@/lib/barcode';
import { statValue, type CrewContent } from '@/lib/content';

interface Props {
  content: CrewContent;
}

const { content } = Astro.props;
const { badge, note } = content;
const cvIsFile = /\.pdf$/.test(badge.cv.href);
// Real Code 128 barcode: label n° 00 of the series ("LM26" → "2600"); the tech cards are 01, 02…
// Drawn as vectors: the pass is tilted, and a bitmap would be deformed by the rotation
const barcode = barcodePath(labelBarcode(badge.id.match(/[A-Z]+(\d+)/)?.[1] ?? '00', 0), 26);
---

<section id="equipage" class="crew" aria-labelledby="crew-title">
  <div class="crew__grid" aria-hidden="true"></div>

  <div class="container crew__inner">
    <div class="crew__top">
      <div class="crew__intro">
        <SectionHead id="crew-title" index={content.index} label={content.label} title={content.title} titleMuted={content.titleMuted} />

        <figure class="note">
          <div class="note__meta">
            <span>{note.entry}</span>
            <span class="note__place">{note.place}</span>
          </div>
          <blockquote class="note__quote">
            <p><span class="note__mark" aria-hidden="true">“</span>{note.quote}<span class="note__mark" aria-hidden="true">”</span></p>
          </blockquote>
          {note.text && <p class="note__text">{note.text}</p>}
          <figcaption class="note__foot">
            <span class="note__sign">— {note.signature} <span class="note__role">· {note.signatureRole}</span></span>
            <span class="note__end" aria-hidden="true">{note.end}</span>
          </figcaption>
        </figure>

        {
          content.offDuty.items.length > 0 && (
            <p class="off-duty">
              <span class="off-duty__label">{content.offDuty.label}</span>
              <span>{content.offDuty.items.join(' · ')}</span>
            </p>
          )
        }
      </div>

      <div class="badge-wrap">
        <span class="badge__lanyard" aria-hidden="true"></span>
        <article class="badge" aria-label={`${badge.title} — ${badge.name}`}>
          <header class="badge__head">
            <span class="badge__slot" aria-hidden="true"></span>
            <span class="badge__title">{badge.title}</span>
          </header>

          <div class="badge__identity">
            <div class="badge__photo">
              <Image src={portrait} alt={badge.photoAlt} widths={[196, 392]} sizes="196px" />
            </div>
            <div class="badge__who">
              <span class="badge__name">{badge.name}</span>
              <span class="badge__job">{badge.job}</span>
            </div>
            <dl class="badge__details">
              {
                badge.details.map((d) => (
                  <div>
                    <dt>{d.label}</dt>
                    <dd>
                      {statValue(d)}
                      {d.suffix && ` ${d.suffix}`}
                    </dd>
                  </div>
                ))
              }
            </dl>
          </div>

          <footer class="badge__foot">
            <span class="badge__code">
              <svg class="barcode" viewBox={`0 0 ${barcode.modules} 26`} preserveAspectRatio="none" aria-hidden="true">
                <path d={barcode.d} fill="currentColor" />
              </svg>
              <span class="badge__id">{badge.id}</span>
            </span>
            <span class="badge__side">
              <span class="badge__status"><span class="badge__status-dot blink" aria-hidden="true"></span>{badge.status}</span>
              <a class="badge__cv" href={badge.cv.href} {...(cvIsFile ? { target: '_blank', rel: 'noopener' } : {})}>{badge.cv.label}</a>
            </span>
          </footer>
        </article>
      </div>
    </div>

    <div class="skills">
      <p class="mono-label">{content.skillsLabel}</p>
      <ul class="skills__list">
        {
          content.skills.map((s) => (
            <li class:list={['skill', { 'is-featured': s.featured }]}>
              <span class="skill__patch">
                <Icon name={s.icon} size={26} strokeWidth={s.featured ? 1.8 : 1.7} />
              </span>
              <div class="skill__body">
                <h3 class="skill__title">{s.title}</h3>
                <p class="skill__text">{s.text}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .crew {
    position: relative;
    overflow: hidden;
    /* Shorter bottom space than other sections: this one is taller */
    padding-block: var(--section-pad-top) min(var(--section-pad-bottom), 6vh);
    background: var(--bg);
  }

  .crew__grid {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      linear-gradient(color-mix(in srgb, var(--text) 3%, transparent) 1px, transparent 1px),
      linear-gradient(90deg, color-mix(in srgb, var(--text) 3%, transparent) 1px, transparent 1px);
    background-size: 80px 80px;
    mask-image: radial-gradient(600px 460px at 80% 34%, black, transparent);
    -webkit-mask-image: radial-gradient(600px 460px at 80% 34%, black, transparent);
  }

  .crew__inner {
    position: relative;
    display: flex;
    flex-direction: column;
    /* Vertical spacing shrinks on short screens so the soft skills stay in view */
    gap: clamp(32px, 4.5vh, 72px);
  }

  .crew__top {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 380px;
    gap: 96px;
    align-items: center;
  }

  .crew__intro {
    display: flex;
    flex-direction: column;
    gap: clamp(14px, 2vh, 22px);
    max-width: 760px;
  }

  .crew__intro :global(h2) {
    font-size: clamp(36px, min(3.9vw, 5.6vh), 56px);
  }

  /* ---------- Pilot's note ---------- */

  .note {
    --note-space: clamp(14px, 2.2vh, 22px);
    margin: 6px 0 0;
    padding: clamp(18px, 2.6vh, 26px) 30px clamp(16px, 2.4vh, 24px);
    border: 1px solid color-mix(in srgb, var(--text) 10%, transparent);
    border-radius: 16px;
    background: color-mix(in srgb, var(--text) 2%, transparent);
  }

  .note__meta {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding-bottom: var(--note-space);
    border-bottom: 1px dashed var(--line-dashed);
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .note__quote {
    margin: var(--note-space) 0 0;
  }

  .note__quote p {
    margin: 0;
    font-size: clamp(18px, min(1.55vw, 2.3vh), 22px);
    line-height: 1.45;
    letter-spacing: -0.01em;
    color: var(--text);
  }

  .note__mark {
    color: var(--accent);
  }

  .note__text {
    margin: clamp(12px, 1.8vh, 18px) 0 0;
    font-size: 16px;
    line-height: 1.6;
    color: var(--text-soft);
  }

  .note__foot {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    margin-top: var(--note-space);
    padding-top: clamp(12px, 1.8vh, 16px);
    border-top: 1px solid var(--line);
  }

  .note__sign {
    font-size: 15px;
    color: var(--text);
  }

  .note__role,
  .note__end {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .note__end {
    font-size: 10.5px;
    letter-spacing: 0.14em;
    color: var(--text-faint);
  }

  .off-duty {
    display: flex;
    align-items: baseline;
    gap: 14px;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1.7;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .off-duty__label {
    flex: none;
    color: var(--accent);
  }

  /* ---------- Badge ---------- */

  .badge-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .badge__lanyard {
    display: block;
    width: 2px;
    height: 70px;
    margin-top: -70px;
    background: linear-gradient(var(--bg), var(--accent));
  }

  .badge {
    width: 320px;
    max-width: 100%;
    overflow: hidden;
    border: 1px solid var(--line-dashed);
    border-radius: 18px;
    background: linear-gradient(165deg, var(--surface-raised), var(--surface) 70%);
    box-shadow:
      0 40px 80px -30px var(--shadow-color),
      0 0 60px -20px color-mix(in srgb, var(--accent) 30%, transparent);
    text-align: center;
    transform: rotate(3deg);
    transition: transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .badge:hover {
    transform: rotate(0deg) translateY(-6px);
  }

  .badge__head {
    position: relative;
    padding: 22px 20px 16px;
    background: var(--accent);
    color: var(--on-accent);
  }

  .badge__slot {
    position: absolute;
    left: 50%;
    top: 10px;
    width: 44px;
    height: 8px;
    border-radius: 99px;
    background: var(--on-accent);
    transform: translateX(-50%);
  }

  .badge__title {
    display: block;
    margin-top: 10px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .badge__identity {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    padding: 22px 24px 18px;
  }

  .badge__photo {
    position: relative;
    width: 136px;
    height: 156px;
    overflow: hidden;
    border: 2px solid var(--accent);
    border-radius: 14px;
    background: radial-gradient(circle at 70% 90%, var(--planet-core), var(--planet-mid) 60%, var(--planet-edge));
  }

  .badge__photo :global(img) {
    position: absolute;
    left: -22px;
    bottom: -4px;
    width: 196px;
    max-width: none;
    height: auto;
  }

  .badge__who {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .badge__name {
    font-size: 28px;
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  .badge__job {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent-alt);
  }

  .badge__details {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(0, 1fr));
    width: 100%;
    margin: 0;
    padding-top: 14px;
    border-top: 1px dashed var(--line-dashed);
  }

  .badge__details div {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
  }

  .badge__details dt {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .badge__details dd {
    margin: 0;
    font-size: 13.5px;
  }

  .badge__foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin: 0 24px;
    padding: 14px 0;
    border-top: 1px solid var(--line-dashed);
  }

  .badge__code,
  .badge__side {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .badge__code {
    align-items: flex-start;
  }

  .badge__side {
    align-items: flex-end;
  }


  .badge__id,
  .badge__status,
  .badge__cv {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .badge__status {
    display: flex;
    align-items: center;
    gap: 7px;
    letter-spacing: 0.12em;
    color: var(--warning);
  }

  .badge__status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--warning);
  }

  .badge__cv {
    padding: 4px 8px;
    border: 1px solid color-mix(in srgb, var(--text) 18%, transparent);
    border-radius: 6px;
    color: var(--text);
    letter-spacing: 0.12em;
    text-decoration: none;
    transition: border-color 0.2s, color 0.2s;
  }

  .badge__cv:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  /* ---------- Soft skills ---------- */

  .skills {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .skills__list {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 32px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .skill {
    display: flex;
    align-items: flex-start;
    gap: 18px;
  }

  .skill__patch {
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 60px;
    height: 60px;
    border: 1.5px solid color-mix(in srgb, var(--accent) 45%, transparent);
    border-radius: 50%;
    background: var(--accent-soft);
    color: var(--accent);
    transition: transform 0.35s, border-color 0.35s;
  }

  .is-featured .skill__patch {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--on-accent);
  }

  .skill:hover .skill__patch {
    transform: rotate(-10deg) scale(1.06);
    border-color: var(--accent);
  }

  .skill__body {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .skill__title {
    margin: 0;
    font-size: 19px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .skill__text {
    margin: 0;
    font-size: 15px;
    line-height: 1.55;
    color: var(--text-subtle);
  }

  /* ---------- Tablet & mobile ---------- */

  @media (max-width: 1099px) {
    .crew {
      border-top: 1px solid var(--line);
    }

    .crew__inner {
      gap: 48px;
    }

    .crew__top {
      grid-template-columns: minmax(0, 1fr);
      gap: 34px;
    }

    .crew__intro {
      gap: 24px;
    }

    .crew__intro {
      max-width: none;
    }

    .badge__lanyard {
      display: none;
    }

    .badge {
      margin-top: 8px;
      transform: rotate(2deg);
    }

    .skills {
      gap: 24px;
    }

    .skills__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 28px 32px;
    }
  }

  @media (max-width: 639px) {
    .note {
      padding: 20px 20px 18px;
    }

    .note__place {
      display: none;
    }

    .note__text {
      font-size: 15px;
    }

    .off-duty {
      flex-direction: column;
      gap: 6px;
      font-size: 10px;
    }

    .badge-wrap {
      padding-inline: 4px;
    }

    .skills__list {
      grid-template-columns: minmax(0, 1fr);
      gap: 22px;
    }

    .skill {
      gap: 14px;
    }

    .skill__patch {
      width: 52px;
      height: 52px;
    }

    .skill__title {
      font-size: 17px;
    }

    .skill__text {
      font-size: 14px;
      line-height: 1.5;
    }
  }
</style>

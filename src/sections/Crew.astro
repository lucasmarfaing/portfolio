---
import { Image } from 'astro:assets';
import portrait from '@/assets/images/portrait.png';
import Icon from '@/components/Icon.astro';
import SectionHead from '@/components/SectionHead.astro';
import { highlights, type CrewContent } from '@/lib/content';

interface Props {
  content: CrewContent;
  callsign: string;
}

const { content, callsign } = Astro.props;
const { badge } = content;
// Widths (px) of the decorative barcode bars
const barcode = [2, 4, 1, 3, 1, 2, 5, 1, 2, 3, 1, 4, 2];
---

<section id="equipage" class="crew" aria-labelledby="crew-title">
  <div class="crew__grid" aria-hidden="true"></div>

  <div class="container crew__inner">
    <div class="crew__top">
      <div class="crew__intro">
        <SectionHead id="crew-title" index={content.index} label={content.label} title={content.title} titleMuted={content.titleMuted} />
        {
          content.paragraphs.map((p) => (
            <p class="crew__text">
              {highlights(p).map((part) => (part.strong ? <strong>{part.text}</strong> : part.text))}
            </p>
          ))
        }
      </div>

      <div class="badge-wrap">
        <span class="badge__lanyard" aria-hidden="true"></span>
        <article class="badge" aria-label={`${badge.title} — ${badge.name}`}>
          <header class="badge__head">
            <span>{badge.title}</span>
            <span class="badge__slot" aria-hidden="true"></span>
            <span>{callsign}</span>
          </header>

          <div class="badge__identity">
            <div class="badge__photo">
              <Image src={portrait} alt={badge.photoAlt} widths={[132, 264]} sizes="132px" />
            </div>
            <div class="badge__who">
              <span class="badge__role">{badge.role}</span>
              <span class="badge__name">{badge.name}</span>
              <span class="badge__job">{badge.job}</span>
            </div>
          </div>

          <dl class="badge__details">
            {
              badge.details.map((d) => (
                <div>
                  <dt>{d.label}</dt>
                  <dd>{d.value}</dd>
                </div>
              ))
            }
          </dl>

          <footer class="badge__foot">
            <span class="badge__barcode" aria-hidden="true">
              {barcode.map((w) => <span style={`width:${w}px`} />)}
            </span>
            <span class="badge__status"><span class="badge__status-dot blink" aria-hidden="true"></span>{badge.status}</span>
          </footer>
        </article>
      </div>
    </div>

    <div class="skills">
      <p class="mono-label">{content.skillsLabel}</p>
      <ul class="skills__list">
        {
          content.skills.map((s) => (
            <li class:list={['skill', { 'is-featured': s.featured }]}>
              <span class="skill__patch">
                <Icon name={s.icon} size={26} strokeWidth={s.featured ? 1.8 : 1.7} />
              </span>
              <div class="skill__body">
                <h3 class="skill__title">{s.title}</h3>
                <p class="skill__text">{s.text}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .crew {
    position: relative;
    overflow: hidden;
    padding-block: var(--section-pad-top) var(--section-pad-bottom);
    background: var(--bg);
  }

  .crew__grid {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      linear-gradient(color-mix(in srgb, var(--text) 3%, transparent) 1px, transparent 1px),
      linear-gradient(90deg, color-mix(in srgb, var(--text) 3%, transparent) 1px, transparent 1px);
    background-size: 80px 80px;
    mask-image: radial-gradient(600px 460px at 80% 34%, black, transparent);
    -webkit-mask-image: radial-gradient(600px 460px at 80% 34%, black, transparent);
  }

  .crew__inner {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 104px;
  }

  .crew__top {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 460px;
    gap: 120px;
    align-items: center;
  }

  .crew__intro {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .crew__text {
    margin: 0;
    max-width: 640px;
    font-size: clamp(17px, 1.5vw, 21px);
    line-height: 1.6;
    color: var(--text-soft);
  }

  .crew__text strong {
    font-weight: inherit;
    color: var(--text);
  }

  /* ---------- Badge ---------- */

  .badge-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .badge__lanyard {
    display: block;
    width: 2px;
    height: 70px;
    margin-top: -70px;
    background: linear-gradient(var(--bg), var(--accent));
  }

  .badge {
    width: 420px;
    max-width: 100%;
    overflow: hidden;
    border: 1px solid var(--line-dashed);
    border-radius: 22px;
    background: linear-gradient(160deg, var(--surface-raised), var(--surface) 60%);
    box-shadow:
      0 40px 80px -30px var(--shadow-color),
      0 0 60px -20px color-mix(in srgb, var(--accent) 25%, transparent);
    transform: rotate(3deg);
    transition: transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .badge:hover {
    transform: rotate(0deg) translateY(-6px);
  }

  .badge__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 22px;
    background: var(--accent);
    color: var(--on-accent);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .badge__slot {
    width: 34px;
    height: 8px;
    border-radius: 99px;
    background: var(--on-accent);
  }

  .badge__identity {
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 22px 22px 18px;
  }

  .badge__photo {
    position: relative;
    flex: none;
    width: 92px;
    height: 108px;
    overflow: hidden;
    border-radius: 12px;
    background: radial-gradient(circle at 70% 90%, var(--planet-core), var(--planet-mid) 60%, var(--planet-edge));
  }

  .badge__photo :global(img) {
    position: absolute;
    left: -20px;
    bottom: -4px;
    width: 132px;
    max-width: none;
    height: auto;
  }

  .badge__who {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .badge__role,
  .badge__details dt {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .badge__name {
    max-width: 8ch;
    font-size: 26px;
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  .badge__job {
    font-size: 14px;
    color: var(--accent-alt);
  }

  .badge__details {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px 20px;
    margin: 0;
    padding: 0 22px;
  }

  .badge__details dt {
    margin-bottom: 4px;
    font-size: 10px;
    letter-spacing: 0.14em;
  }

  .badge__details dd {
    margin: 0;
    font-size: 15px;
  }

  .badge__foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 22px;
    padding: 16px 22px;
    border-top: 1px dashed var(--line-strong);
  }

  .badge__barcode {
    display: flex;
    gap: 2px;
    height: 26px;
  }

  .badge__barcode span {
    background: var(--text);
  }

  .badge__status {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .badge__status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--warning);
  }

  /* ---------- Soft skills ---------- */

  .skills {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .skills__list {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 32px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .skill {
    display: flex;
    align-items: flex-start;
    gap: 18px;
  }

  .skill__patch {
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 60px;
    height: 60px;
    border: 1.5px solid color-mix(in srgb, var(--accent) 45%, transparent);
    border-radius: 50%;
    background: var(--accent-soft);
    color: var(--accent);
    transition: transform 0.35s, border-color 0.35s;
  }

  .is-featured .skill__patch {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--on-accent);
  }

  .skill:hover .skill__patch {
    transform: rotate(-10deg) scale(1.06);
    border-color: var(--accent);
  }

  .skill__body {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .skill__title {
    margin: 0;
    font-size: 19px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .skill__text {
    margin: 0;
    font-size: 15px;
    line-height: 1.55;
    color: var(--text-subtle);
  }

  /* ---------- Tablet & mobile ---------- */

  @media (max-width: 1099px) {
    .crew {
      border-top: 1px solid var(--line);
    }

    .crew__inner {
      gap: 48px;
    }

    .crew__top {
      grid-template-columns: minmax(0, 1fr);
      gap: 34px;
    }

    .crew__intro {
      gap: 24px;
    }

    .badge__lanyard {
      display: none;
    }

    .badge {
      transform: rotate(-1.5deg);
    }

    .skills {
      gap: 24px;
    }

    .skills__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 28px 32px;
    }
  }

  @media (max-width: 639px) {
    .badge-wrap {
      padding-inline: 4px;
    }

    .badge {
      border-radius: 20px;
    }

    .badge__head {
      padding: 13px 18px;
      font-size: 10px;
    }

    .badge__identity {
      gap: 14px;
      padding: 18px;
    }

    .badge__photo {
      width: 76px;
      height: 90px;
      border-radius: 10px;
    }

    .badge__photo :global(img) {
      left: -16px;
      bottom: -3px;
      width: 110px;
    }

    .badge__name {
      max-width: none;
      font-size: 22px;
    }

    .badge__job {
      font-size: 13px;
    }

    .badge__details {
      gap: 14px 16px;
      padding: 0 18px;
    }

    .badge__details dd {
      font-size: 14px;
    }

    .badge__foot {
      margin-top: 18px;
      padding: 14px 18px;
    }

    .skills__list {
      grid-template-columns: minmax(0, 1fr);
      gap: 22px;
    }

    .skill {
      gap: 14px;
    }

    .skill__patch {
      width: 52px;
      height: 52px;
    }

    .skill__title {
      font-size: 17px;
    }

    .skill__text {
      font-size: 14px;
      line-height: 1.5;
    }
  }
</style>

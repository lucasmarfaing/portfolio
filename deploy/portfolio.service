# systemd service for the portfolio's small Node server (it only answers /api/contact).
# Install:  sudo cp deploy/portfolio.service /etc/systemd/system/
#           sudo systemctl daemon-reload && sudo systemctl enable --now portfolio
# Logs:     journalctl -u portfolio -f
#
# Adjust User and WorkingDirectory to your server.

[Unit]
Description=Portfolio LM-26 — contact API (Astro Node server)
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/var/www/portfolio
EnvironmentFile=/var/www/portfolio/.env
ExecStart=/usr/bin/node dist/server/entry.mjs
Restart=on-failure
RestartSec=3

# Hardening: the process can only read its own folder
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/var/www/portfolio

[Install]
WantedBy=multi-user.target

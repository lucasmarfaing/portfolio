# Copy this file to `.env` on the server (never commit the real one) and fill in the values.
# Used only by the contact form route (/api/contact).

# Mailbox that SENDS the messages (ask@lucasmarfaing.pro is a redirect, so it can't send).
# Gmail example: enable 2-step verification, then create an "App password" for the portfolio.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your.address@gmail.com
SMTP_PASS=your-app-password

# Where messages arrive (the redirect forwards them to you)
CONTACT_TO=ask@lucasmarfaing.pro
# Optional: sender address shown in the email (defaults to SMTP_USER)
# CONTACT_FROM=

# Node server (behind nginx)
HOST=127.0.0.1
PORT=4321
